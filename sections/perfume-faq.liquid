{%- comment -%}
  FAQ: questions and answers as an accordion (native <details>, so it works without
  JS and with the keyboard). Left: heading, a line and a contact link, pinned while
  the questions scroll on desktop. Right: one block per question; "One open at a
  time" closes the others (the details name attribute). Optional FAQPage structured
  data so search engines can show the answers.

  Answers must be true for the store: the defaults only say what the site already
  shows (free delivery over ₱10,000, notes on every page, the quiz) or general
  knowledge (EDP vs EDT), and point to checkout or the policies for the rest.

  Styles: assets/perfume-faq.css.
{%- endcomment -%}
{%- liquid
  assign fid = 'PerfumeFaq-' | append: section.id
  assign qs = section.blocks | where: 'type', 'question'
-%}

{{ 'perfume-faq.css' | asset_url | stylesheet_tag }}
<script src="{{ 'perfume-reveal.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  #{{ fid }} {
    --pq-bg: {{ section.settings.background_color }};
    --pq-ink: {{ section.settings.text_color }};
    --pq-pt: {{ section.settings.padding_top }}px;
    --pq-pb: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<section id="{{ fid }}" class="pfq" aria-labelledby="{{ fid }}-h">
  <div class="pfq__wrap">
    <div class="pfq__intro" data-pf-reveal="rise">
      {%- if section.settings.kicker != blank -%}<p class="pf-kicker pfq__kicker">{{ section.settings.kicker | escape }}</p>{%- endif -%}
      <h2 class="pfq__h" id="{{ fid }}-h">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}<div class="pfq__text">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.settings.link_label != blank and section.settings.link != blank -%}
        <a class="pf-link pfq__link" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }}</a>
      {%- endif -%}
    </div>

    <div class="pfq__list">
      {%- for block in qs -%}
        <details class="pfq__item" {% if section.settings.one_open %}name="{{ fid }}"{% endif %}{% if forloop.first and section.settings.open_first %} open{% endif %} {{ block.shopify_attributes }}>
          <summary class="pfq__q">
            <span class="pfq__q-text">{{ block.settings.question | escape }}</span>
            <span class="pfq__icon" aria-hidden="true"></span>
          </summary>
          <div class="pfq__a rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>

  {%- if section.settings.structured_data and qs.size > 0 -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {%- for block in qs -%}
            {
              "@type": "Question",
              "name": {{ block.settings.question | json }},
              "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | strip | json }} }
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      }
    </script>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "FAQ",
  "tag": "div",
  "class": "section-perfume-faq",
  "disabled_on": { "groups": ["header", "footer"] },
  "max_blocks": 16,
  "settings": [
    { "type": "paragraph", "content": "Only answers that are true for your store. For delivery times, returns and payment, link your policies or say where the details show (checkout)." },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Questions" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Good to know" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Can't find your answer? We're happy to help.</p>" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Contact us" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "checkbox", "id": "one_open", "label": "One open at a time", "default": true },
    { "type": "checkbox", "id": "open_first", "label": "First question open", "default": false },
    { "type": "checkbox", "id": "structured_data", "label": "Add FAQ structured data for search engines", "info": "Use it on one page only (e.g. the home page or an FAQ page).", "default": true },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F3F0EB" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#26221F" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Are your perfumes authentic?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Yes. We sell authentic designer fragrances only.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "question", "settings": { "question": "Are your perfumes authentic?", "answer": "<p>Yes. We sell authentic designer fragrances only.</p>" } },
        { "type": "question", "settings": { "question": "How much is delivery?", "answer": "<p>Delivery is free on orders over ₱10,000. For smaller orders, the fee and the delivery options for your address show at checkout.</p>" } },
        { "type": "question", "settings": { "question": "How do I choose a perfume I've never smelled?", "answer": "<p>Every perfume page shows its top, heart and base notes, how it wears and when to wear it. Not sure where to start? Take the <a href=\"/pages/find-your-scent\">Find your scent</a> quiz: four questions point you to a scent.</p>" } },
        { "type": "question", "settings": { "question": "What's the difference between Eau de Parfum and Eau de Toilette?", "answer": "<p>Eau de Parfum has a higher concentration of perfume oils than Eau de Toilette, so it usually smells richer and lasts longer. How long any perfume lasts still depends on the perfume, your skin and the weather.</p>" } },
        { "type": "question", "settings": { "question": "Can I return a perfume?", "answer": "<p>Please see our <a href=\"/policies/refund-policy\">refund policy</a> for what can be returned and how.</p>" } },
        { "type": "question", "settings": { "question": "How can I pay?", "answer": "<p>All the payment options we accept show at checkout.</p>" } }
      ]
    }
  ]
}
{% endschema %}
