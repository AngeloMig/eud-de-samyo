{%- comment -%}
  Shop by scent family: a heading, then a row of tiles, one per fragrance family
  (fresh, spicy, sweet…), each a colour field with an ingredient image filling its
  top, the family's name and a line about it, linking to its collection. A "Find
  your scent" block makes a dark call-to-action tile. Tiles wipe in one after another
  as the row scrolls into view (assets/perfume-reveal.js). Phones (under 750px): a
  carousel: swipe or drag with the mouse, arrows and dots, snapping to each tile.

  Styles: assets/perfume-families.css. Script: assets/perfume-families.js.
{%- endcomment -%}
{%- liquid
  assign fid = 'PerfumeFamilies-' | append: section.id
-%}

{{ 'perfume-families.css' | asset_url | stylesheet_tag }}
<script src="{{ 'perfume-reveal.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'perfume-families.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  #{{ fid }} {
    --pfa-bg: {{ section.settings.background_color }};
    --pfa-ink: {{ section.settings.text_color }};
    --pfa-pt: {{ section.settings.padding_top }}px;
    --pfa-pb: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<section id="{{ fid }}" class="pfa" aria-labelledby="{{ fid }}-heading">
  <div class="pfa__head" data-pf-reveal="rise">
    <div>
      {%- if section.settings.kicker != blank -%}
        <p class="pfa__kicker pf-kicker">{{ section.settings.kicker | escape }}</p>
      {%- endif -%}
      <h2 class="pfa__heading" id="{{ fid }}-heading">{{ section.settings.heading | escape }}</h2>
    </div>
    {%- if section.settings.link_label != blank and section.settings.link != blank -%}
      <a class="pf-link" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }}</a>
    {%- endif -%}
  </div>

  <perfume-families class="pfa__track">
  <ul class="pfa__grid" role="list" data-pfa-list>
    {%- for block in section.blocks -%}
      {%- assign url = block.settings.link | default: routes.all_products_collection_url -%}
      <li class="pfa-tile pfa-tile--{{ block.type }}" style="--i: {{ forloop.index0 }}; --tile-bg: {{ block.settings.background_color }};" data-pf-reveal="wipe" {{ block.shopify_attributes }}>
        <a class="pfa-tile__link" href="{{ url }}">
          {%- if block.type == 'family' -%}
            <span class="pfa-tile__media">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 900 | image_tag: widths: '400, 600, 900', sizes: '(min-width: 990px) 24vw, 78vw', loading: 'lazy', alt: '' }}
              {%- else -%}
                {%- render 'perfume-sample-image', key: block.settings.sample, alt: '' -%}
              {%- endif -%}
            </span>
            <span class="pfa-tile__body">
              <span class="pfa-tile__title">{{ block.settings.title | escape }}</span>
              {%- if block.settings.text != blank -%}<span class="pfa-tile__text">{{ block.settings.text | escape }}</span>{%- endif -%}
            </span>
          {%- else -%}
            <span class="pfa-tile__body pfa-tile__body--cta">
              <span class="pfa-tile__script" aria-hidden="true">{{ block.settings.script | escape }}</span>
              <span class="pfa-tile__title">{{ block.settings.title | escape }}</span>
              {%- if block.settings.text != blank -%}<span class="pfa-tile__text">{{ block.settings.text | escape }}</span>{%- endif -%}
              <span class="pfa-tile__cta">{{ block.settings.button_label | escape }} <span aria-hidden="true">→</span></span>
            </span>
          {%- endif -%}
        </a>
      </li>
    {%- endfor -%}
  </ul>

  <div class="pfa__controls" data-pfa-controls hidden>
    <div class="pfa__dots" role="group" aria-label="Choose a scent family">
      {%- for block in section.blocks -%}
        {%- assign dot_label = block.settings.title | default: 'Tile' -%}
        <button type="button" class="pfa__dot" data-pfa-dot="{{ forloop.index0 }}" aria-label="{{ dot_label | escape }}"{% if forloop.first %} aria-current="true"{% endif %}>
          <span aria-hidden="true"></span>
        </button>
      {%- endfor -%}
    </div>
    <div class="pfa__arrows">
      <button type="button" class="pfa__arrow" data-pfa-prev aria-label="Previous scent family" disabled>
        <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M12 4l-6 6 6 6"/></svg>
      </button>
      <button type="button" class="pfa__arrow" data-pfa-next aria-label="Next scent family">
        <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M8 4l6 6-6 6"/></svg>
      </button>
    </div>
  </div>
  </perfume-families>
</section>

{% schema %}
{
  "name": "Shop by scent family",
  "tag": "div",
  "class": "section-perfume-families",
  "max_blocks": 6,
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Shop by scent" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What do you like to smell like?" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "All fragrances" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F1EEE9" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#26221F" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "family",
      "name": "Scent family",
      "settings": [
        { "type": "text", "id": "title", "label": "Family", "default": "Fresh & citrus" },
        { "type": "text", "id": "text", "label": "Line", "default": "Lemon, bergamot, mint. Bright and clean." },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "An ingredient photo; it fills the top of the tile." },
        {
          "type": "select",
          "id": "sample",
          "label": "Sample image (until an image is set)",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "scent-lemon", "label": "Lemon" },
            { "value": "scent-cinnamon", "label": "Cinnamon" },
            { "value": "scent-vanilla", "label": "Vanilla" }
          ],
          "default": "none"
        },
        { "type": "color", "id": "background_color", "label": "Background", "default": "#F2E27E" },
        { "type": "url", "id": "link", "label": "Link", "info": "The family's collection." }
      ]
    },
    {
      "type": "cta",
      "name": "Find your scent tile",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "script", "label": "Handwritten line", "default": "not sure?" },
        { "type": "text", "id": "title", "label": "Title", "default": "Find your scent" },
        { "type": "text", "id": "text", "label": "Line", "default": "Tell us what you like; we'll match notes to perfumes." },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Start" },
        { "type": "color", "id": "background_color", "label": "Background", "default": "#26221F" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by scent family",
      "blocks": [
        { "type": "family", "settings": { "title": "Fresh & citrus", "text": "Lemon, bergamot, mint. Bright and clean.", "sample": "scent-lemon", "background_color": "#F2E27E" } },
        { "type": "family", "settings": { "title": "Warm & spicy", "text": "Cinnamon, pepper, cardamom. Warm and bold.", "sample": "scent-cinnamon", "background_color": "#E2A07E" } },
        { "type": "family", "settings": { "title": "Sweet & creamy", "text": "Vanilla, tonka, amber. Soft and close.", "sample": "scent-vanilla", "background_color": "#EFE6D2" } },
        { "type": "cta", "settings": {} }
      ]
    }
  ]
}
{% endschema %}
