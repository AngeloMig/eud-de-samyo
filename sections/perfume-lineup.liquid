{%- comment -%}
  Bottle lineup, after High Spirits' "Product Lineup", smaller and in Sangyo's type:
  a serif heading with a handwritten line over it, then an endless row of slightly
  overlapping bottles that drifts slowly, pauses for hover, focus or touch, drags
  with the mouse or finger and glides to a stop, and loops both ways. Each bottle
  lifts on hover and shows its name. Hovering it (or keyboard focus) stops the drift.

  Blocks: one per bottle (a product, or an image with a link).
  Script: assets/perfume-lineup.js (<perfume-lineup>). Styles: assets/perfume-lineup.css.
{%- endcomment -%}
{%- liquid
  assign lid = 'PerfumeLineup-' | append: section.id
-%}

{{ 'perfume-lineup.css' | asset_url | stylesheet_tag }}
<script src="{{ 'perfume-lineup.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'perfume-reveal.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  #{{ lid }} {
    --pl-bg: {{ section.settings.background_color }};
    --pl-ink: {{ section.settings.text_color }};
    --pl-card: {{ section.settings.bottle_width }}px;
    --pl-mobile-card: {{ section.settings.bottle_width_mobile }}px;
    --pl-overlap: {{ section.settings.overlap | divided_by: 100.0 }};
    --pl-pt: {{ section.settings.padding_top }}px;
    --pl-pb: {{ section.settings.padding_bottom }}px;
    --pl-script-ink: {{ section.settings.script_color }};
    --pl-radius: {{ section.settings.corner_radius }}px;
    --pl-radius-mobile: {{ section.settings.corner_radius_mobile }}px;
    {% if section.settings.show_shadow %}--pl-shadow: 0 14px 28px -18px rgba(41, 37, 33, 0.34);{% else %}--pl-shadow: none;{% endif %}
  }
{%- endstyle -%}

<div class="pl-surround" style="background: {{ section.settings.surround_color }};">
<perfume-lineup
  id="{{ lid }}"
  class="pl"
  data-speed="{{ section.settings.speed }}"
  data-autoplay="{{ section.settings.autoplay }}"
  data-pf-reveal="lineup"
>
  {%- if section.settings.heading != blank or section.settings.script != blank -%}
    <h2 class="pl__heading">
      {%- if section.settings.heading != blank -%}
        <span class="pl__main">{{ section.settings.heading | escape }}</span>
      {%- endif -%}
      {%- if section.settings.script != blank -%}
        <span class="pl__script">{{ section.settings.script | escape }}</span>
      {%- endif -%}
    </h2>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <div
      class="pl__strip"
      role="region"
      aria-roledescription="carousel"
      aria-label="{{ section.settings.heading | append: ' ' | append: section.settings.script | strip | default: 'Bottles' | escape }}"
      tabindex="0"
      data-pl-strip
    >
      <ul class="pl__track" role="list" data-pl-track>
        {%- for block in section.blocks -%}
          {%- liquid
            assign p = block.settings.product
            assign img = block.settings.image
            if img == blank and p != blank
              assign img = p.featured_media.preview_image
            endif
            assign url = block.settings.link
            if url == blank and p != blank
              assign url = p.url
            endif
            assign label = block.settings.label
            if label == blank and p != blank
              assign label = p.title
            endif
          -%}
          <li class="pl__item" {{ block.shopify_attributes }}>
            {%- if url != blank -%}<a class="pl__card" href="{{ url }}">{%- else -%}<div class="pl__card">{%- endif -%}
              <span class="pl__media">
                {%- if img != blank -%}
                  {{ img | image_url: width: 600 | image_tag: widths: '200, 300, 400, 600', sizes: '(max-width: 749px) 120px, 180px', loading: 'lazy', alt: '', class: 'pl__img', draggable: 'false' }}
                {%- else -%}
                  {%- render 'perfume-bottle-art', shape: 'column', uid: block.id -%}
                {%- endif -%}
              </span>
              {%- if label != blank -%}
                <span class="pl__label">
                  {%- if p != blank and p.vendor != blank -%}<span class="pl__brand">{{ p.vendor | escape }}</span>{%- endif -%}
                  {{ label | escape }}
                </span>
              {%- endif -%}
            {%- if url != blank -%}</a>{%- else -%}</div>{%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>

  {%- endif -%}

  {%- if section.settings.button_label != blank -%}
    <div class="pl__foot">
      <a class="pf-button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}</a>
    </div>
  {%- endif -%}
</perfume-lineup>
</div>

{% schema %}
{
  "name": "Bottle lineup",
  "tag": "div",
  "class": "section-perfume-lineup",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Keep exploring" },
    { "type": "text", "id": "script", "label": "Handwritten line", "default": "one spray at a time" },
    { "type": "checkbox", "id": "autoplay", "label": "Drift slowly on its own", "info": "Pauses while hovered, touched or keyboard-focused.", "default": true },
    { "type": "range", "id": "speed", "label": "Drift speed", "min": 10, "max": 80, "step": 5, "unit": "px", "default": 30 },
    { "type": "range", "id": "bottle_width", "label": "Bottle width (desktop)", "min": 100, "max": 260, "step": 10, "unit": "px", "default": 170 },
    { "type": "range", "id": "bottle_width_mobile", "label": "Bottle width (phone)", "min": 70, "max": 180, "step": 2, "unit": "px", "default": 110 },
    { "type": "range", "id": "overlap", "label": "Overlap", "min": 0, "max": 40, "step": 1, "unit": "%", "default": 5 },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop all fragrances" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#E8E4DC" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#292521" },
    { "type": "color", "id": "script_color", "label": "Handwritten line", "default": "#686A54" },
    { "type": "color", "id": "surround_color", "label": "Behind the rounded corners", "info": "Match this to the next section's background.", "default": "#D8D1C5" },
    { "type": "range", "id": "corner_radius", "label": "Bottom corners (desktop)", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 40 },
    { "type": "range", "id": "corner_radius_mobile", "label": "Bottom corners (phone)", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 28 },
    { "type": "checkbox", "id": "show_shadow", "label": "Show a soft shadow", "default": true },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "bottle",
      "name": "Bottle",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "A transparent bottle. Falls back to the product's image." },
        { "type": "text", "id": "label", "label": "Name on hover", "info": "Falls back to the product title." },
        { "type": "url", "id": "link", "label": "Link", "info": "Falls back to the product page." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bottle lineup",
      "blocks": [
        { "type": "bottle", "settings": { "label": "Bottle one" } },
        { "type": "bottle", "settings": { "label": "Bottle two" } },
        { "type": "bottle", "settings": { "label": "Bottle three" } },
        { "type": "bottle", "settings": { "label": "Bottle four" } }
      ]
    }
  ]
}
{% endschema %}
