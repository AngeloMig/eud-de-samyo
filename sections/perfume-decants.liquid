{%- comment -%}
  Decants: small decants (1, 2, 5, 10 ml) poured from full bottles, sold in bundles.
  Row 1: size cards (blocks "size"), each with a vial picture; choosing one shows that
  size's bundles. Row 2: bundle cards (blocks "bundle"). Under it: an optional,
  clearly labelled partner (affiliate) link for the full bottle.

  Bundle price: from the chosen product if any (its lowest variant, with "from" when the
  variants differ, e.g. one per scent tier), otherwise the block's own price text
  (e.g. "₱590"). Size cards show "from ₱x" = the lowest price per vial among that
  size's bundles. Without JavaScript every bundle is shown.

  Styles: assets/perfume-decants.css. Script: assets/perfume-decants.js.
{%- endcomment -%}
{%- liquid
  assign did = 'PerfumeDecants-' | append: section.id
  assign sizes = section.blocks | where: 'type', 'size'
  assign bundles = section.blocks | where: 'type', 'bundle'
  assign first_size = sizes.first.settings.size | default: '1'
-%}

{{ 'perfume-decants.css' | asset_url | stylesheet_tag }}
<script src="{{ 'perfume-decants.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'perfume-reveal.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  #{{ did }} {
    --pdc-bg: {{ section.settings.background_color }};
    --pdc-ink: {{ section.settings.text_color }};
    --pdc-card: {{ section.settings.card_color }};
    --pdc-pt: {{ section.settings.padding_top }}px;
    --pdc-pb: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<section id="{{ did }}" class="pdc" aria-labelledby="{{ did }}-h" data-pdc data-first="{{ first_size }}">
  <div class="pdc__wrap">
    <div class="pdc__head" data-pf-reveal="rise">
      <div>
        {%- if section.settings.kicker != blank -%}<p class="pf-kicker pdc__kicker">{{ section.settings.kicker | escape }}</p>{%- endif -%}
        <h2 class="pdc__h" id="{{ did }}-h">{{ section.settings.heading | escape }}{% if section.settings.heading_italic != blank %} <em>{{ section.settings.heading_italic | escape }}</em>{% endif %}</h2>
      </div>
      {%- if section.settings.text != blank -%}<div class="pdc__text">{{ section.settings.text }}</div>{%- endif -%}
      {%- liquid
        assign hero_src = blank
        if section.settings.hero_image != blank
          assign hero_src = section.settings.hero_image
        endif
      -%}
      {%- if hero_src != blank -%}
        {{ hero_src | image_url: width: 600 | image_tag: widths: '300, 600', sizes: '240px', class: 'pdc__hero', loading: 'lazy', alt: '' }}
      {%- elsif section.settings.hero_sample -%}
        <img class="pdc__hero" src="{{ 'sample-decant-set.webp' | asset_url }}" width="631" height="700" alt="" loading="lazy">
      {%- endif -%}
    </div>

    {%- liquid
      assign picker_url = section.settings.picker_page.url
      if picker_url == blank
        assign picker_url = pages['build-your-set'].url
      endif
    -%}
    {%- if section.settings.layout == 'featured' -%}
      {%- comment -%}
        One featured set (bundle block with "Feature this set", else the first) as a
        large dark card, the others as vial cards beside it, then a "Build your own"
        tile. Cards: snippets/perfume-decant-card.liquid.
      {%- endcomment -%}
      {%- liquid
        assign feat = bundles.first
        assign feat_i = 1
        for b in bundles
          if b.settings.featured
            assign feat = b
            assign feat_i = forloop.index
            break
          endif
        endfor
      -%}
      {%- if bundles.size > 0 -%}
        <div class="pdf">
          {%- render 'perfume-decant-card', block: feat, picker_url: picker_url, featured: true, featured_label: section.settings.featured_label, bg_text: section.settings.featured_bg_text, from_label: section.settings.set_from_label, to_label: section.settings.set_to_label, soon_label: section.settings.soon_label -%}
          {%- for block in bundles -%}
            {%- if forloop.index == feat_i -%}{%- continue -%}{%- endif -%}
            {%- render 'perfume-decant-card', block: block, picker_url: picker_url, featured: false, from_label: section.settings.set_from_label, to_label: section.settings.set_to_label, soon_label: section.settings.soon_label -%}
          {%- endfor -%}
          {%- if picker_url != blank and section.settings.cta_label != blank -%}
            <a class="pdf__own" href="{{ picker_url }}">
              <span class="pdf__slots" aria-hidden="true"><i>+</i><i>+</i><i>+</i></span>
              <span class="pdf__name">{{ section.settings.cta_label | escape }}</span>
              {%- if section.settings.cta_note != blank -%}<span class="pdf__what">{{ section.settings.cta_note | escape }}</span>{%- endif -%}
              {%- if section.settings.cta_button != blank -%}<span class="pdf__own-btn">{{ section.settings.cta_button | escape }} <span aria-hidden="true">→</span></span>{%- endif -%}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- elsif section.settings.layout == 'sets' -%}
      {%- comment -%}
        Sets as vial cards (same look as the vial picker): each set shows its vials at
        their real relative size, its price range and opens the picker with that set.
      {%- endcomment -%}
      {%- if bundles.size > 0 -%}
        <ul class="pdc__sets" role="list">
          {%- for block in bundles -%}
            {%- liquid
              assign bs = block.settings.size
              assign bp = block.settings.product
              case bs
                when '1'
                  assign v_img = 'sample-decant-square.webp'
                  assign v_h = 44
                when '2'
                  assign v_img = 'sample-decant-clear.webp'
                  assign v_h = 62
                when '5'
                  assign v_img = 'sample-decant-amber.webp'
                  assign v_h = 82
                else
                  assign v_img = 'sample-decant-amber.webp'
                  assign v_h = 100
              endcase
              assign v_shown = block.settings.count | at_most: 6
              assign b_note = ''
              for sz in sizes
                if sz.settings.size == bs
                  assign b_note = sz.settings.note
                endif
              endfor
              if bp != blank
                assign p_lo = bp.price_min | money
                assign p_hi = ''
                if bp.price_varies
                  assign p_hi = bp.price_max | money
                endif
              else
                assign p_lo = block.settings.price | split: '–' | first | strip
                assign p_hi = block.settings.price | split: '–' | last | strip
                if p_hi == p_lo
                  assign p_hi = ''
                endif
              endif
              assign b_url = block.settings.link
              if b_url == blank and picker_url != blank
                assign b_url = picker_url | append: '?set=' | append: block.settings.count | append: 'x' | append: bs
              endif
              assign from_txt = section.settings.set_from_label | replace: '[price]', p_lo
              assign to_txt = section.settings.set_to_label | replace: '[price]', p_hi
            -%}
            <li class="pdc__set" style="--i: {{ forloop.index0 }};" {{ block.shopify_attributes }}>
              {%- if b_url != blank -%}<a class="pdc__set-card" href="{{ b_url }}">{%- else -%}<div class="pdc__set-card">{%- endif -%}
                {%- if block.settings.badge != blank -%}<span class="pdc__badge">{{ block.settings.badge | escape }}</span>{%- endif -%}
                <span class="pdc__set-vials" style="--vh: {{ v_h }}%;" data-n="{{ v_shown }}" aria-hidden="true">
                  {%- for i in (1..v_shown) -%}
                    <img src="{{ v_img | asset_url }}" alt="" width="40" height="160" loading="lazy" style="--j: {{ forloop.index0 }};">
                  {%- endfor -%}
                </span>
                <span class="pdc__set-name">{{ block.settings.title | escape }}{% if block.settings.title_italic != blank %} <em>{{ block.settings.title_italic | escape }}</em>{% endif %}</span>
                <span class="pdc__set-what">{{ block.settings.count }} × {{ bs }} ml</span>
                {%- if b_note != blank -%}<span class="pdc__set-note">{{ b_note | escape }}</span>{%- endif -%}
                <span class="pdc__set-price">
                  <span class="pdc__set-from">{{ from_txt | escape }}</span>
                  {%- if p_hi != blank -%}<span class="pdc__set-to">{{ to_txt | escape }}</span>{%- endif -%}
                </span>
                <span class="pdc__set-cta">
                  {%- if b_url != blank -%}{{ block.settings.button_label | default: 'Pick your scents' | escape }} <span aria-hidden="true">→</span>{%- else -%}{{ section.settings.soon_label | escape }}{%- endif -%}
                </span>
              {%- if b_url != blank -%}</a>{%- else -%}</div>{%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
        {%- if picker_url != blank and section.settings.cta_label != blank -%}
          <p class="pdc__more"><a class="pdc__cta" href="{{ picker_url }}">{{ section.settings.cta_label | escape }} <span aria-hidden="true">→</span></a>{%- if section.settings.cta_note != blank -%}<span>{{ section.settings.cta_note | escape }}</span>{%- endif -%}</p>
        {%- endif -%}
      {%- endif -%}
    {%- else -%}
    {%- if sizes.size > 0 -%}
      <div class="pdc__sizes" role="group" aria-label="{{ section.settings.sizes_label | escape }}">
        {%- for block in sizes -%}
          {%- liquid
            assign s = block.settings.size
            assign best = 0
            for b in bundles
              if b.settings.size == s
                if b.settings.product != blank
                  assign p_num = b.settings.product.price | divided_by: 100.0
                else
                  assign p_first = b.settings.price | split: '–' | first | split: ' - ' | first
                  assign p_num = p_first | remove: '₱' | remove: 'PHP' | remove: 'from' | remove: ',' | strip | plus: 0
                endif
                assign per = p_num | times: 1.0 | divided_by: b.settings.count
                if p_num > 0
                  if best == 0 or per < best
                    assign best = per
                  endif
                endif
              endif
            endfor
          -%}
          <button type="button" class="pdc__size" data-pdc-size="{{ s }}" aria-pressed="{% if s == first_size %}true{% else %}false{% endif %}" style="--i: {{ forloop.index0 }}; --vh: {{ block.settings.height }}%;" {{ block.shopify_attributes }}>
            {%- if best > 0 -%}
              {%- liquid
                assign whole = best | round | floor
                assign th = whole | divided_by: 1000 | floor
                assign rest = whole | modulo: 1000
                if th > 0
                  assign rest_s = rest | prepend: '00' | slice: -3, 3
                  assign shown = th | append: ',' | append: rest_s
                else
                  assign shown = whole
                endif
              -%}
              <span class="pdc__from">{{ section.settings.from_label | escape }} ₱{{ shown }}</span>
            {%- endif -%}
            <span class="pdc__vial" aria-hidden="true">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 300 | image_tag: widths: '150, 300', sizes: '120px', loading: 'lazy', alt: '' }}
              {%- elsif block.settings.sample != 'none' -%}
                {%- liquid
                  case block.settings.sample
                    when 'square'
                      assign v_w = 168
                      assign v_h = 700
                    when 'clear'
                      assign v_w = 90
                      assign v_h = 533
                    else
                      assign v_w = 97
                      assign v_h = 700
                  endcase
                  assign v_src = 'sample-decant-' | append: block.settings.sample | append: '.webp'
                -%}
                <img src="{{ v_src | asset_url }}" width="{{ v_w }}" height="{{ v_h }}" alt="" loading="lazy">
              {%- endif -%}
            </span>
            <span class="pdc__ml">{{ s }} ml</span>
            {%- if block.settings.note != blank -%}<span class="pdc__note">{{ block.settings.note | escape }}</span>{%- endif -%}
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if bundles.size > 0 -%}
      <ul class="pdc__bundles" role="list" aria-live="polite">
        {%- for block in bundles -%}
          {%- liquid
            assign bp = block.settings.product
            assign b_url = block.settings.link
            if bp != blank
              assign b_url = bp.url
            endif
            assign b_count = block.settings.count
          -%}
          <li class="pdc__bundle pdc__bundle--{{ block.settings.style }}" data-pdc-bundle="{{ block.settings.size }}" {{ block.shopify_attributes }}>
            {%- if block.settings.badge != blank -%}<span class="pdc__badge">{{ block.settings.badge | escape }}</span>{%- endif -%}
            <span class="pdc__name">{{ block.settings.title | escape }}{% if block.settings.title_italic != blank %} <em>{{ block.settings.title_italic | escape }}</em>{% endif %}</span>
            <span class="pdc__what">{{ b_count }} × {{ block.settings.size }} ml · {{ section.settings.pick_label | replace: '[n]', b_count }}</span>
            <span class="pdc__price">
              {%- if bp != blank -%}
                {% if bp.price_varies %}{{ section.settings.from_label | escape }} {% endif %}{{ bp.price_min | money }}{% if bp.compare_at_price > bp.price %}<s>{{ bp.compare_at_price | money }}</s>{% endif %}
              {%- else -%}
                {% if block.settings.price_from %}{{ section.settings.from_label | escape }} {% endif %}{{ block.settings.price | escape }}{% if block.settings.compare_price != blank %}<s>{{ block.settings.compare_price | escape }}</s>{% endif %}
              {%- endif -%}
            </span>
            {%- if block.settings.button_label != blank -%}
              {%- if b_url != blank -%}
                <a class="pdc__btn" href="{{ b_url }}">{{ block.settings.button_label | escape }} <span aria-hidden="true">→</span></a>
              {%- else -%}
                <span class="pdc__btn is-soon">{{ section.settings.soon_label | escape }}</span>
              {%- endif -%}
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
    {%- endif -%}

    {%- if section.settings.show_size_guide -%}
      {%- render 'perfume-vial-size', id: section.id, class: 'pdc__size-guide', picker_url: picker_url -%}
    {%- endif -%}

    {%- if section.settings.partner_text != blank and section.settings.partner_link != blank -%}
      <p class="pdc__partner">
        <span>{{ section.settings.partner_text | escape }} <a href="{{ section.settings.partner_link }}" rel="sponsored noopener" target="_blank">{{ section.settings.partner_label | escape }} <span aria-hidden="true">→</span></a></span>
        {%- if section.settings.partner_disclosure != blank -%}<span class="pdc__disclose">{{ section.settings.partner_disclosure | escape }}</span>{%- endif -%}
      </p>
    {%- endif -%}

    {%- if request.design_mode and bundles.size == 0 -%}
      <p class="pdc__hint">Add bundle blocks (for example 3 × 1 ml) to show deals under the sizes.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Decants",
  "tag": "div",
  "class": "section-perfume-decants",
  "disabled_on": { "groups": ["header", "footer"] },
  "max_blocks": 16,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Decants" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Try it before" },
    { "type": "text", "id": "heading_italic", "label": "Heading, italic part", "default": "the full bottle" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Poured from authentic full bottles, labelled by hand. Wear it for a week; buy the bottle only if you love it.</p>" },
    { "type": "checkbox", "id": "hero_sample", "label": "Show the built-in vials photo", "default": true },
    { "type": "image_picker", "id": "hero_image", "label": "Own photo next to the heading", "info": "A transparent cut-out works best. Replaces the built-in one." },
    { "type": "checkbox", "id": "show_size_guide", "label": "Show the vial size guide", "info": "Vials at actual size. Heights: Theme settings → Sangyó vial sizes.", "default": true },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "featured", "label": "One featured set, the rest beside it" },
        { "value": "sets", "label": "Set cards that open the vial picker" },
        { "value": "sizes", "label": "Sizes, then bundles" }
      ],
      "default": "featured"
    },
    { "type": "text", "id": "featured_label", "label": "Label on the featured set", "info": "Featured layout. Choose the set in its block (Feature this set).", "default": "Our pick" },
    { "type": "text", "id": "featured_bg_text", "label": "Word behind the featured set", "info": "Large and faint, behind the vials. Leave empty to use the set's italic word (e.g. six)." },
    { "type": "page", "id": "picker_page", "label": "Vial picker page", "info": "Set cards open it with that set chosen. Empty: the page with the handle build-your-set." },
    { "type": "text", "id": "set_from_label", "label": "Set cards: lowest price", "info": "[price] = the bundle's first price.", "default": "from [price]" },
    { "type": "text", "id": "set_to_label", "label": "Set cards: highest price", "info": "[price] = the bundle's second price (after the –).", "default": "up to [price]" },
    { "type": "text", "id": "cta_label", "label": "Link under the set cards", "default": "Build your own set" },
    { "type": "text", "id": "cta_note", "label": "Line next to that link", "default": "Mix any scents. Each perfume once per set." },
    { "type": "text", "id": "cta_button", "label": "Build-your-own button", "default": "Start building" },
    { "type": "text", "id": "sizes_label", "label": "Size picker label (screen readers)", "default": "Choose a size" },
    { "type": "text", "id": "from_label", "label": "Price prefix on sizes", "default": "from" },
    { "type": "text", "id": "pick_label", "label": "Bundle line", "default": "pick any [n] of our scents", "info": "[n] becomes the number of vials." },
    { "type": "text", "id": "soon_label", "label": "Button text when a bundle has no link", "default": "Coming soon" },
    { "type": "header", "content": "Partner link (full bottle)" },
    { "type": "text", "id": "partner_text", "label": "Text", "default": "Fell in love? Get the full bottle from our partner." },
    { "type": "text", "id": "partner_label", "label": "Link label", "default": "See the full bottle" },
    { "type": "url", "id": "partner_link", "label": "Partner link", "info": "Opens in a new tab and is marked as a sponsored link." },
    { "type": "text", "id": "partner_disclosure", "label": "Disclosure", "default": "Partner link · we may earn a commission" },
    { "type": "header", "content": "Colours and spacing" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F7F5F0" },
    { "type": "color", "id": "card_color", "label": "Cards", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#292521" },
    { "type": "range", "id": "padding_top", "label": "Space above", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Space below", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "size",
      "name": "Size",
      "settings": [
        {
          "type": "select",
          "id": "size",
          "label": "Size",
          "options": [
            { "value": "1", "label": "1 ml" },
            { "value": "2", "label": "2 ml" },
            { "value": "5", "label": "5 ml" },
            { "value": "10", "label": "10 ml" }
          ],
          "default": "1"
        },
        { "type": "text", "id": "note", "label": "Note", "default": "≈ 10–15 sprays · to try" },
        {
          "type": "select",
          "id": "sample",
          "label": "Built-in vial photo",
          "options": [
            { "value": "square", "label": "Small square vial" },
            { "value": "clear", "label": "Clear spray vial" },
            { "value": "amber", "label": "Amber spray vial" },
            { "value": "none", "label": "None" }
          ],
          "default": "square"
        },
        { "type": "image_picker", "id": "image", "label": "Own vial photo", "info": "A transparent cut-out. Replaces the built-in one." },
        { "type": "range", "id": "height", "label": "Vial height", "info": "Show sizes in proportion: smaller for 1 ml, full for 10 ml.", "min": 30, "max": 100, "step": 5, "unit": "%", "default": 45 }
      ]
    },
    {
      "type": "bundle",
      "name": "Bundle",
      "settings": [
        { "type": "text", "id": "title", "label": "Name", "default": "Try" },
        { "type": "text", "id": "title_italic", "label": "Name, italic part", "default": "trio" },
        { "type": "checkbox", "id": "featured", "label": "Feature this set", "info": "Featured layout: the large dark card. Only the first one ticked is used.", "default": false },
        { "type": "textarea", "id": "featured_text", "label": "Line on the featured card", "default": "Six different perfumes, a few days each: the easiest way to find your signature scent." },
        {
          "type": "select",
          "id": "size",
          "label": "Vial size",
          "options": [
            { "value": "1", "label": "1 ml" },
            { "value": "2", "label": "2 ml" },
            { "value": "5", "label": "5 ml" },
            { "value": "10", "label": "10 ml" }
          ],
          "default": "1"
        },
        { "type": "range", "id": "count", "label": "Number of vials", "min": 1, "max": 10, "step": 1, "default": 3 },
        { "type": "product", "id": "product", "label": "Product", "info": "Its price and page are used. Without a product, the price text and link below are shown." },
        { "type": "text", "id": "price", "label": "Price", "info": "A price or a range, e.g. ₱315 – ₱1,035 when it depends on the scents picked.", "default": "₱590" },
        { "type": "checkbox", "id": "price_from", "label": "Show “from” before the price text", "info": "For sets priced by scent tier. With a product, “from” shows when its variants have different prices.", "default": false },
        { "type": "text", "id": "compare_price", "label": "Struck-out price", "info": "Optional, e.g. the price of the vials bought one by one." },
        { "type": "text", "id": "badge", "label": "Badge", "info": "Optional, e.g. Save 15%." },
        { "type": "url", "id": "link", "label": "Link", "info": "Used when no product is chosen." },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Pick your scents" },
        {
          "type": "select",
          "id": "style",
          "label": "Card",
          "options": [
            { "value": "dark", "label": "Dark" },
            { "value": "light", "label": "Light" }
          ],
          "default": "dark"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Decants",
      "blocks": [
        { "type": "size", "settings": { "size": "1", "note": "≈ 10–15 sprays · to try", "sample": "square", "height": 45 } },
        { "type": "size", "settings": { "size": "2", "note": "≈ 25–30 sprays · a week", "sample": "clear", "height": 60 } },
        { "type": "size", "settings": { "size": "5", "note": "≈ 70 sprays · a month", "sample": "amber", "height": 80 } },
        { "type": "size", "settings": { "size": "10", "note": "≈ 150 sprays · travel size", "sample": "amber", "height": 100 } },
        { "type": "bundle", "settings": { "title": "Try", "title_italic": "trio", "size": "1", "count": 3, "price": "₱590" } }
      ]
    }
  ]
}
{% endschema %}
