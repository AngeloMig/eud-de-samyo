{%- comment -%}
  Shop by brand. Two layouts (setting "Layout"):
  - Masonry (default): brand tiles in mixed sizes (normal / big / wide / tall) on
    their colour, with scent-note blocks in between as bare cut-outs (no background:
    just the lavender, the rose…) that are a little bigger than their spot and
    spill past it. Tiles unveil with a staggered curtain wipe as the section comes
    into view; "Load more" unveils the next ones the same way. Phones: a 6-column
    grid, brands half width (big/wide full), notes a third, grouped in rows of three
    under the first brand. Without JS everything simply shows.
  - Grid: the earlier even grid of brand tiles.
  Script: assets/perfume-shop-brands.js.

  Shop by brand (grid layout): a grid of brand tiles. Each tile is the brand name set large in the
  display serif on a soft tint, with the number of perfumes; on hover (desktop) the
  brand's bottle rises into the tile and the tint deepens. Phones: a swipeable row
  (scroll snap) with the bottle shown when there is one.

  Each block picks the brand's collection: the name, link, count and picture come
  from it (picture = the block's image, else the collection image, else its first
  product's photo). Without a collection the tile links to /collections/<name>.
  Pictures must be ones the store may use (docs/CREDITS.md).

  Styles: assets/perfume-shop-brands.css. Reveal: assets/perfume-reveal.js.
{%- endcomment -%}
{%- liquid
  assign sid = 'PerfumeShopBrands-' | append: section.id
  assign tiles = section.blocks | where: 'type', 'brand'
  assign masonry = false
  if section.settings.layout == 'masonry'
    assign masonry = true
    assign tiles = section.blocks
  endif
  assign first_count = section.settings.initial_count
  if first_count == 0 or first_count > tiles.size or request.design_mode
    assign first_count = tiles.size
  endif
-%}

{{ 'perfume-shop-brands.css' | asset_url | stylesheet_tag }}
<script src="{{ 'perfume-reveal.js' | asset_url }}" defer="defer"></script>
{%- if masonry -%}<script src="{{ 'perfume-shop-brands.js' | asset_url }}" defer="defer"></script>{%- endif -%}

{%- style -%}
  #{{ sid }} {
    --psb-bg: {{ section.settings.background_color }};
    --psb-ink: {{ section.settings.text_color }};
    --psb-pt: {{ section.settings.padding_top }}px;
    --psb-pb: {{ section.settings.padding_bottom }}px;
    --psb-cols: {{ section.settings.columns }};
  }
{%- endstyle -%}

<section id="{{ sid }}" class="psb{% if masonry %} psb--masonry{% endif %}" aria-labelledby="{{ sid }}-h"{% if masonry %} data-psb data-step="{{ section.settings.load_step }}"{% endif %}>
  <div class="psb__head" data-pf-reveal="rise">
    <div>
      {%- if section.settings.kicker != blank -%}<p class="pf-kicker psb__kicker">{{ section.settings.kicker | escape }}</p>{%- endif -%}
      <h2 class="psb__h" id="{{ sid }}-h">{{ section.settings.heading | escape }}</h2>
    </div>
    {%- if section.settings.link_label != blank and section.settings.link != blank -%}
      <a class="pf-link psb__all" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }}</a>
    {%- endif -%}
  </div>

  <ul class="psb__grid" role="list">
    {%- for block in tiles -%}
      {%- if block.type == 'note' -%}
        {%- liquid
          assign n_sample = block.settings.sample
          case n_sample
            when 'lavender'
              assign n_w = 415
              assign n_h = 700
            when 'rose'
              assign n_w = 527
              assign n_h = 700
            when 'orange'
              assign n_w = 678
              assign n_h = 689
            when 'iris'
              assign n_w = 409
              assign n_h = 700
            when 'cardamom'
              assign n_w = 700
              assign n_h = 462
            when 'vanilla'
              assign n_w = 900
              assign n_h = 483
            when 'lemon'
              assign n_w = 900
              assign n_h = 587
            when 'cinnamon'
              assign n_w = 743
              assign n_h = 700
          endcase
          assign n_tag = 'a'
          if block.settings.link == blank
            assign n_tag = 'div'
          endif
        -%}
        <li class="psb__item psb__item--note psb__item--{{ block.settings.size }}" style="--i: {{ forloop.index0 }};"{% if forloop.index > first_count %} data-later{% endif %} {{ block.shopify_attributes }}>
          <{{ n_tag }} class="psb__note{% if block.settings.stem %} psb__note--stem{% endif %}"{% if block.settings.link != blank %} href="{{ block.settings.link }}"{% endif %}>
            <span class="psb__note-art" aria-hidden="true">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 700 | image_tag: widths: '350, 700', sizes: '(min-width: 990px) 22vw, 33vw', loading: 'lazy', alt: '' }}
              {%- elsif n_sample != blank and n_sample != 'none' -%}
                {%- assign n_src = 'sample-scent-' | append: n_sample | append: '.webp' -%}
                <img src="{{ n_src | asset_url }}" alt="" width="{{ n_w }}" height="{{ n_h }}" loading="lazy">
              {%- endif -%}
            </span>
            <span class="psb__name psb__name--note">{{ block.settings.name | escape }}</span>
            {%- if section.settings.note_label != blank -%}<span class="psb__count">{{ section.settings.note_label | escape }}</span>{%- endif -%}
          </{{ n_tag }}>
        </li>
        {%- continue -%}
      {%- endif -%}
      {%- liquid
        assign c = block.settings.collection
        assign b_name = block.settings.name
        if b_name == blank
          assign b_name = c.title
        endif
        assign b_url = c.url
        if b_url == blank
          assign b_handle = b_name | handleize
          assign b_url = routes.collections_url | default: '/collections' | append: '/' | append: b_handle
        endif
        assign b_img = block.settings.image
        if b_img == blank and block.settings.group_images
          assign b_img = c.products.first.featured_media.preview_image
        endif
        if b_img == blank
          assign b_img = c.image
        endif
        if b_img == blank
          assign b_img = c.products.first.featured_media.preview_image
        endif
        assign b_img_2 = block.settings.image_2
        assign b_img_3 = block.settings.image_3
        if block.settings.group_images and c != blank
          if b_img_2 == blank
            assign b_img_2 = c.products[1].featured_media.preview_image
          endif
          if b_img_3 == blank
            assign b_img_3 = c.products[2].featured_media.preview_image
          endif
        endif
        assign b_count = c.products_count
      -%}
      <li class="psb__item{% if masonry %} psb__item--{{ block.settings.size | default: 'normal' }}{% if block.settings.spill %} is-spill{% endif %}{% endif %}" style="--i: {{ forloop.index0 }}; --tile: {{ block.settings.tint }};"{% if masonry %}{% if forloop.index > first_count %} data-later{% endif %}{% else %} data-pf-reveal="rise"{% endif %} {{ block.shopify_attributes }}>
        <a class="psb__tile{% if b_img != blank %} has-img{% endif %}{% if b_img_2 != blank or b_img_3 != blank %} psb__tile--group{% endif %}" href="{{ b_url }}">
          <span class="psb__media" aria-hidden="true">
            {%- if b_img != blank -%}
              {{ b_img | image_url: width: 400 | image_tag: widths: '200, 400', sizes: '(min-width: 990px) 14vw, 40vw', loading: 'lazy', alt: '' }}
            {%- endif -%}
            {%- if b_img_2 != blank -%}
              {{ b_img_2 | image_url: width: 400 | image_tag: widths: '200, 400', sizes: '(min-width: 990px) 8vw, 24vw', loading: 'lazy', alt: '' }}
            {%- endif -%}
            {%- if b_img_3 != blank -%}
              {{ b_img_3 | image_url: width: 400 | image_tag: widths: '200, 400', sizes: '(min-width: 990px) 8vw, 24vw', loading: 'lazy', alt: '' }}
            {%- endif -%}
          </span>
          <span class="psb__name">{{ b_name | escape }}</span>
          {%- if b_count > 0 -%}
            <span class="psb__count">{{ b_count }} {% if b_count == 1 %}perfume{% else %}perfumes{% endif %}</span>
          {%- else -%}
            <span class="psb__count">{{ section.settings.shop_label | escape }}</span>
          {%- endif -%}
        </a>
      </li>
    {%- endfor -%}
  </ul>
  {%- if masonry and first_count < tiles.size -%}
    <div class="psb__more" data-psb-more hidden>
      <button type="button" class="psb__more-btn" data-psb-more-btn>
        {{ section.settings.load_more_label | escape }} <small data-psb-left>· {{ tiles.size | minus: first_count }} more</small>
      </button>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Shop by brand",
  "tag": "div",
  "class": "section-perfume-shop-brands",
  "disabled_on": { "groups": ["header", "footer"] },
  "max_blocks": 30,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Shop by brand" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The houses we carry" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "All brands" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "text", "id": "shop_label", "label": "Tile text when the count is unknown", "default": "Shop" },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "masonry", "label": "Masonry with scent notes" },
        { "value": "grid", "label": "Even grid (brands only)" }
      ],
      "default": "masonry"
    },
    { "type": "range", "id": "columns", "label": "Tiles per row (even grid, desktop)", "min": 3, "max": 6, "step": 1, "default": 5 },
    { "type": "text", "id": "note_label", "label": "Label under scent notes (masonry)", "default": "Scent note" },
    { "type": "range", "id": "initial_count", "label": "Tiles shown before Load more (masonry)", "info": "0 shows all.", "min": 0, "max": 30, "step": 1, "default": 13 },
    { "type": "range", "id": "load_step", "label": "Tiles added per Load more", "min": 2, "max": 12, "step": 1, "default": 6 },
    { "type": "text", "id": "load_more_label", "label": "Load more label", "default": "Load more" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F7F5F0" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#292521" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Brand collection", "info": "Name, link, count and picture come from it." },
        { "type": "text", "id": "name", "label": "Name", "info": "Falls back to the collection title." },
        { "type": "image_picker", "id": "image", "label": "Picture", "info": "Falls back to the collection image, then its first product's photo. A transparent bottle works best." },
        { "type": "image_picker", "id": "image_2", "label": "Second bottle" },
        { "type": "image_picker", "id": "image_3", "label": "Third bottle" },
        { "type": "checkbox", "id": "group_images", "label": "Group bottles from the collection", "info": "Uses the second and third product photos when no bottle images are chosen above.", "default": true },
        { "type": "color", "id": "tint", "label": "Tile colour", "default": "#E8E3DB" },
        {
          "type": "select",
          "id": "size",
          "label": "Size (masonry)",
          "options": [
            { "value": "normal", "label": "Normal" },
            { "value": "big", "label": "Big (2 × 2)" },
            { "value": "wide", "label": "Wide (2 × 1)" },
            { "value": "tall", "label": "Tall (1 × 2)" }
          ],
          "default": "normal"
        },
        { "type": "checkbox", "id": "spill", "label": "Bottles break out of the tile (masonry)", "info": "The bottles rise above the tile's top edge.", "default": false }
      ]
    },
    {
      "type": "note",
      "name": "Scent note",
      "settings": [
        { "type": "paragraph", "content": "Shown in the masonry layout as a bare cut-out, no background." },
        { "type": "text", "id": "name", "label": "Note", "default": "Lavender" },
        {
          "type": "select",
          "id": "sample",
          "label": "Built-in cut-out",
          "options": [
            { "value": "lavender", "label": "Lavender" },
            { "value": "rose", "label": "Rose" },
            { "value": "iris", "label": "Iris" },
            { "value": "orange", "label": "Orange" },
            { "value": "lemon", "label": "Lemon" },
            { "value": "vanilla", "label": "Vanilla" },
            { "value": "cinnamon", "label": "Cinnamon" },
            { "value": "cardamom", "label": "Cardamom" },
            { "value": "none", "label": "None (use the image below)" }
          ],
          "default": "lavender"
        },
        { "type": "image_picker", "id": "image", "label": "Own image", "info": "A transparent cut-out (PNG/WebP). Replaces the built-in one." },
        { "type": "url", "id": "link", "label": "Link", "info": "E.g. a collection of perfumes with this note." },
        {
          "type": "select",
          "id": "size",
          "label": "Size",
          "options": [
            { "value": "normal", "label": "Normal" },
            { "value": "tall", "label": "Tall (1 × 2)" },
            { "value": "wide", "label": "Wide (2 × 1)" }
          ],
          "default": "normal"
        },
        {
          "type": "checkbox",
          "id": "stem",
          "label": "Cut stem: run it to the bottom of the tile",
          "info": "For cut flowers (lavender, iris) whose stem ends in a straight cut: the picture sits on the tile's bottom edge and the cut fades out.",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by brand",
      "blocks": [
        { "type": "brand", "settings": { "name": "Dior", "tint": "#D6DDE5" } },
        { "type": "brand", "settings": { "name": "Chanel", "tint": "#E8E3DB" } },
        { "type": "brand", "settings": { "name": "Hermès", "tint": "#EAD8C2" } },
        { "type": "brand", "settings": { "name": "Tom Ford", "tint": "#DCD6E4" } },
        { "type": "brand", "settings": { "name": "YSL", "tint": "#E9D3C9" } }
      ]
    }
  ]
}
{% endschema %}
