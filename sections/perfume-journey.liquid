{%- comment -%}
  Fragrance journey: how the scent evolves, told as you scroll (no clicking needed).
  Opening (top notes) → Heart (middle notes) → Dry-down (base notes).

  All three stages are stacked and always readable: each has its line and its
  notes as real photos (snippets/perfume-note-art: photo first; a note's own
  metaobject image wins). Long lists show the first ten and "Show all n notes".
  - Desktop: a timeline stays pinned on the left while the stages scroll by; its
    line fills continuously, the current stage lights up and the background shifts.
  - Phones: a slim progress bar with the three dots sticks to the top of the
    section while you scroll through it.
  The stage names are also links that jump to their stage. No durations are claimed.

  Script: assets/perfume-discovery.js (<perfume-journey>). Styles: assets/perfume-discovery.css.
{%- endcomment -%}
{%- liquid
  assign profile = metaobject
  if profile == blank
    assign profile = product.metafields.fragrance.profile.value
  endif
  assign jid = 'PerfumeJourney-' | append: section.id
  assign name = profile.name.value | default: product.title
  assign show_max = section.settings.show_max
-%}

{{ 'perfume-discovery.css' | asset_url | stylesheet_tag }}
<script src="{{ 'perfume-discovery.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'perfume-reveal.js' | asset_url }}" defer="defer"></script>

<perfume-journey
  id="{{ jid }}"
  class="pjr"
  data-stage="1"
  style="--pjr-c1: {{ section.settings.color_1 }}; --pjr-c2: {{ section.settings.color_2 }}; --pjr-c3: {{ section.settings.color_3 }}; --pjr-ink: {{ section.settings.text_color }};"
>
  <span class="pd-anchor" id="notes"></span>
  <div class="pd-head" data-pf-reveal="rise">
    <p class="pd-kicker">{{ section.settings.kicker | escape }}</p>
    <h2 class="pd-h">{{ section.settings.heading | replace: '[name]', name | escape }}</h2>
  </div>

  <div class="pjr__body">
    <nav class="pjr__rail" aria-label="{{ section.settings.kicker | escape }}">
      <span class="pjr__line" aria-hidden="true"><span></span></span>
      <ol class="pjr__steps" role="list">
        {%- for stage in (1..3) -%}
          {%- liquid
            case stage
              when 1
                assign s_name = section.settings.top_label
                assign s_sub = section.settings.top_sub
              when 2
                assign s_name = section.settings.heart_label
                assign s_sub = section.settings.heart_sub
              else
                assign s_name = section.settings.base_label
                assign s_sub = section.settings.base_sub
            endcase
          -%}
          <li>
            <a class="pjr__step{% if stage == 1 %} is-current{% endif %}" href="#{{ jid }}-stage-{{ stage }}" data-stage="{{ stage }}"{% if stage == 1 %} aria-current="step"{% endif %}>
              <span class="pjr__dot" aria-hidden="true"></span>
              <span class="pjr__step-name">{{ s_name | escape }}</span>
              <span class="pjr__step-sub">{{ s_sub | escape }}</span>
            </a>
          </li>
        {%- endfor -%}
      </ol>
    </nav>

    <div class="pjr__stages">
      {%- for stage in (1..3) -%}
        {%- liquid
          case stage
            when 1
              assign group = profile.top_notes.value | default: product.metafields.fragrance.top_notes.value
              assign s_text = profile.opening_text.value | default: section.settings.top_text
              assign s_name = section.settings.top_label
              assign s_sub = section.settings.top_sub
            when 2
              assign group = profile.middle_notes.value | default: product.metafields.fragrance.middle_notes.value
              assign s_text = profile.heart_text.value | default: section.settings.heart_text
              assign s_name = section.settings.heart_label
              assign s_sub = section.settings.heart_sub
            else
              assign group = profile.base_notes.value | default: product.metafields.fragrance.base_notes.value
              assign s_text = profile.drydown_text.value | default: section.settings.base_text
              assign s_name = section.settings.base_label
              assign s_sub = section.settings.base_sub
          endcase
          assign count = group.size | default: 0
        -%}
        <section class="pjr__stage" id="{{ jid }}-stage-{{ stage }}" data-stage="{{ stage }}" aria-labelledby="{{ jid }}-t{{ stage }}">
          <div class="pjr__copy">
            <p class="pjr__num" aria-hidden="true">0{{ stage }} · {{ s_sub | escape }}</p>
            <h3 class="pjr__title" id="{{ jid }}-t{{ stage }}">{{ s_name | escape }}</h3>
            {%- if s_text != blank -%}<p class="pjr__text">{{ s_text | escape }}</p>{%- endif -%}
          </div>
          {%- if count > 0 -%}
            <ul class="pjr__notes" role="list">
              {%- for nn in group -%}
                {%- assign n_desc = nn.description.value -%}
                <li class="pjr__note{% if forloop.index > show_max %} is-extra{% endif %}" style="--i: {{ forloop.index0 | at_most: 9 }};">
                  <span class="pjr__photo" aria-hidden="true">
                    {%- if nn.image.value != blank -%}
                      {{ nn.image.value | image_url: width: 300 | image_tag: alt: '', loading: 'lazy' }}
                    {%- else -%}
                      {%- render 'perfume-note-art', note: nn.art.value -%}
                    {%- endif -%}
                  </span>
                  <span class="pjr__note-name">{{ nn.name.value | escape }}</span>
                  {%- if n_desc != blank -%}<span class="pjr__note-desc">{{ n_desc | escape }}</span>{%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
            {%- if count > show_max -%}
              <button type="button" class="pjr__more" data-pjr-more aria-expanded="false" data-label="Show all {{ count }} notes">Show all {{ count }} notes</button>
            {%- endif -%}
          {%- else -%}
            <p class="pjr__empty">{{ section.settings.empty_text | escape }}</p>
          {%- endif -%}
        </section>
      {%- endfor -%}

      {%- if section.settings.note != blank -%}
        <p class="pd-basis pjr__foot">{{ section.settings.note | escape }}</p>
      {%- endif -%}
    </div>
  </div>
</perfume-journey>

{% schema %}
{
  "name": "Fragrance journey",
  "tag": "div",
  "class": "section-perfume-journey",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "The notes" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "[name] becomes the fragrance name.", "default": "How [name] unfolds on skin" },
    { "type": "range", "id": "show_max", "label": "Notes shown before Show all", "min": 4, "max": 20, "step": 1, "default": 10 },
    { "type": "text", "id": "top_label", "label": "Stage 1", "default": "Opening" },
    { "type": "text", "id": "top_sub", "label": "Stage 1 small text", "default": "Top notes" },
    { "type": "text", "id": "top_text", "label": "Stage 1 line (when the profile has none)", "default": "What you smell first: the brightest, lightest notes, quick to fade." },
    { "type": "text", "id": "heart_label", "label": "Stage 2", "default": "Heart" },
    { "type": "text", "id": "heart_sub", "label": "Stage 2 small text", "default": "Middle notes" },
    { "type": "text", "id": "heart_text", "label": "Stage 2 line (when the profile has none)", "default": "The character that comes through as the opening fades." },
    { "type": "text", "id": "base_label", "label": "Stage 3", "default": "Dry-down" },
    { "type": "text", "id": "base_sub", "label": "Stage 3 small text", "default": "Base notes" },
    { "type": "text", "id": "base_text", "label": "Stage 3 line (when the profile has none)", "default": "The deeper notes that tend to stay on skin and clothes." },
    { "type": "text", "id": "empty_text", "label": "No notes text", "default": "Notes not added yet." },
    { "type": "text", "id": "note", "label": "Note under the section", "default": "How long each stage lasts depends on the perfume, your skin and the weather." },
    { "type": "color", "id": "color_1", "label": "Opening background", "default": "#F6F1DD" },
    { "type": "color", "id": "color_2", "label": "Heart background", "default": "#F1E6EC" },
    { "type": "color", "id": "color_3", "label": "Dry-down background", "default": "#EDE5DA" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#26221F" }
  ],
  "presets": [{ "name": "Fragrance journey" }]
}
{% endschema %}
