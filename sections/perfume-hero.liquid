{%- comment -%}
  Perfume hero (NOHO-style split hero).

  Left half: paper background, an oversized heading (one line per line of the text
  box), an optional handwritten accent, and a small slogan at the bottom.
  Right half: stone background with up to seven tiles in a staggered 2-3-2 grid that
  runs off the right edge. Each tile is a coloured field with a cut-out image: a
  perfume bottle or a scent (lemon, cinnamon, vanilla…). A tile can show a label and
  link somewhere.

  Intro (optional, once per browser session for the preloader): a paper cover with a
  charcoal bar rising from the bottom, which then lifts away; the heading lines slide
  up out of masks one after another; the tiles wipe in from the bottom one by one with
  their image settling from a slight zoom; the slogan and header fade in.
  A dot cursor follows the pointer over the hero and grows over linked tiles (mouse
  only). Floating tiles (setting): the tiles stay locked to the grid; only the image
  inside each one moves (cut-outs drift a few px, full photos zoom very slowly).
  Hover notes: a perfume tile with "Notes shown on hover" swaps the scent tiles for
  its notes, placed in random free cells, while it is hovered or focused.
  Reduced motion: no intro, no cursor, no floating; notes still swap, without motion.

  Script: assets/perfume-hero.js (<perfume-hero>). Styles: assets/perfume-hero.css.
{%- endcomment -%}
{%- liquid
  assign sid = 'PerfumeHero-' | append: section.id
  assign tiles = section.blocks | where: 'type', 'tile'
  assign heading_lines = section.settings.heading | newline_to_br | split: '<br />'
-%}

{{ 'perfume-hero.css' | asset_url | stylesheet_tag }}
<script src="{{ 'perfume-hero.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  #{{ sid }} {
    --phh-left: {{ section.settings.left_background }};
    --phh-right: {{ section.settings.right_background }};
    --phh-ink: {{ section.settings.text_color }};
    --phh-h: {{ section.settings.heading_size }}px;
    --phh-h-m: {{ section.settings.heading_size_mobile }}px;
    --phh-loader: {{ section.settings.preloader_color }};
  }
{%- endstyle -%}

{%- if section.settings.animate_intro -%}
  {%- comment -%} Start state before the hero is parsed, so its end state never flashes first. {%- endcomment -%}
  <script>if(!matchMedia('(prefers-reduced-motion: reduce)').matches)document.documentElement.classList.add('pf-intro-pre');</script>
{%- endif -%}
<perfume-hero
  id="{{ sid }}"
  class="phh{% if section.settings.labels_on_touch %} phh--labels-touch{% endif %}{% if section.settings.intro_speed == 'fast' %} phh--fast{% endif %}{% if section.settings.float_tiles %} phh--float{% endif %}"
  data-speed="{{ section.settings.intro_speed }}"
  data-intro="{{ section.settings.animate_intro }}"
  data-preloader="{{ section.settings.show_preloader }}"
  data-cursor="{{ section.settings.show_cursor }}"
>
  {%- if section.settings.show_preloader and section.settings.animate_intro -%}
    <div class="phh-loader" data-phh-loader hidden aria-hidden="true">
      <div class="phh-loader__fill"></div>
    </div>
  {%- endif -%}

  <div class="phh__left">
    <{{ section.settings.heading_tag }} class="phh__heading">
      {%- for line in heading_lines -%}
        {%- assign clean_line = line | strip_newlines | strip -%}
        {%- if clean_line != blank -%}
          <span class="phh__line" style="--i: {{ forloop.index0 }};"><span>{{ clean_line | escape }}</span></span>
          {%- unless forloop.last %} {% endunless -%}
        {%- endif -%}
      {%- endfor -%}
    </{{ section.settings.heading_tag }}>

    {%- if section.settings.accent != blank -%}
      <p class="phh__accent" aria-hidden="true">{{ section.settings.accent | escape }}</p>
    {%- endif -%}

    {%- if section.settings.button_label != blank or section.settings.button2_label != blank -%}
      <div class="phh__actions">
        {%- if section.settings.button_label != blank -%}
          {%- assign b1 = section.settings.button_link | default: routes.all_products_collection_url -%}
          <a class="pf-button phh__button" href="{{ b1 }}">{{ section.settings.button_label | escape }}</a>
        {%- endif -%}
        {%- if section.settings.button2_label != blank -%}
          {%- assign b2 = section.settings.button2_link | default: routes.all_products_collection_url -%}
          <a class="pf-link phh__link" href="{{ b2 }}">{{ section.settings.button2_label | escape }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="phh__foot">
      {%- if section.settings.slogan != blank -%}
        <p class="phh__slogan">{{ section.settings.slogan | escape }}</p>
      {%- endif -%}
      {%- assign trust_lines = section.settings.trust_points | newline_to_br | split: '<br />' -%}
      {%- capture trust_html -%}
        {%- for line in trust_lines -%}
          {%- assign t = line | strip_newlines | strip -%}
          {%- if t != blank -%}<li>{{ t | escape }}</li>{%- endif -%}
        {%- endfor -%}
      {%- endcapture -%}
      {%- if trust_html != blank -%}
        <ul class="phh__trust" role="list">{{ trust_html }}</ul>
      {%- endif -%}
    </div>
  </div>

  <div class="phh__right">
    <ul class="phh__grid" role="list">
      {%- for block in tiles limit: 7 -%}
        {%- liquid
          assign label = block.settings.label | escape
          assign has_link = false
          if block.settings.link != blank
            assign has_link = true
          endif
          assign img_loading = 'lazy'
          if forloop.index <= 3
            assign img_loading = 'eager'
          endif
          assign img_alt = block.settings.label
          # A tile with hover notes is a perfume: hovering it swaps the scent tiles for its
          # notes. Tiles that don't open a product (scents) make way while notes show.
          assign tile_role = ' phh-tile--scent'
          if block.settings.hover_notes != blank
            assign tile_role = ' phh-tile--perfume'
          elsif block.settings.link contains 'products'
            assign tile_role = ''
          endif
        -%}
        <li
          class="phh-tile phh-tile--{{ block.settings.image_fit }} phh-tile--{{ block.settings.image_position }}{{ tile_role }}"
          {% if block.settings.hover_notes != blank %}data-notes="{{ block.id }}"{% endif %}
          style="--i: {{ forloop.index0 }}; --tile-bg: {{ block.settings.background_color }}; --tile-scale: {{ block.settings.image_scale | divided_by: 100.0 }}; --tilt: {{ block.settings.image_tilt }}deg;"
          {{ block.shopify_attributes }}
        >
          {%- comment -%} The cursor grows into "View" only over tiles that open a product; scent tiles keep the dot. {%- endcomment -%}
          {%- if has_link -%}<a class="phh-tile__inner" href="{{ block.settings.link }}"{% if block.settings.link contains 'products' %} data-phh-hover{% endif %}>{%- else -%}<div class="phh-tile__inner">{%- endif -%}
            <span class="phh-tile__media"><span class="phh-tile__pose">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 800
                  | image_tag: widths: '300, 500, 800', sizes: '(min-width: 750px) 14vw, 42vw', loading: img_loading, alt: img_alt
                }}
              {%- else -%}
                {%- render 'perfume-sample-image', key: block.settings.sample, alt: img_alt, loading: img_loading -%}
              {%- endif -%}
            </span></span>
            {%- if section.settings.label_style == 'spine' -%}
              {%- liquid
                assign spine = block.settings.spine_text
                if spine == blank
                  if block.settings.kicker != blank and label != blank
                    assign spine = block.settings.kicker | append: ' · ' | append: block.settings.label
                  else
                    assign spine = block.settings.label | default: block.settings.kicker
                  endif
                endif
                # Label colour: a deep shade of the tile's own colour (or a light one on a dark tile).
                assign tile_brightness = block.settings.background_color | color_brightness
                if tile_brightness < 120
                  assign spine_color = block.settings.background_color | color_lighten: 62
                else
                  assign spine_color = block.settings.background_color | color_darken: 58
                endif
              -%}
              {%- if spine != blank -%}
                <span class="phh-tile__spine" style="--spine: {{ spine_color }};">{{ spine | escape }}</span>
              {%- endif -%}
            {%- elsif label != blank -%}
              <span class="phh-tile__label">
                {%- if block.settings.kicker != blank -%}<span class="phh-tile__kicker">{{ block.settings.kicker | escape }}</span>{%- endif -%}
                <span class="phh-tile__name">{{ label }}</span>
              </span>
            {%- endif -%}
          {%- if has_link -%}</a>{%- else -%}</div>{%- endif -%}
        </li>
      {%- endfor -%}

      {%- comment -%}
        Each perfume's notes, shown in random free cells while that perfume is hovered or
        focused (assets/perfume-hero.js). Decorative: the product page lists the notes.
        Real photos only: the tile's own note upload, the bundled cut-out, or the theme's
        licensed note photo; with none, the note's name on its colour.
      {%- endcomment -%}
      {%- for block in tiles limit: 7 -%}
        {%- if block.settings.hover_notes != blank -%}
          {%- assign hover_notes = block.settings.hover_notes | split: ',' -%}
          {%- assign note_index = 0 -%}
          {%- for raw_note in hover_notes -%}
            {%- assign note_name = raw_note | strip -%}
            {%- if note_name != blank and note_index < 3 -%}
              {%- liquid
                assign note_key = note_name | downcase | replace: ' ', '_' | replace: '-', '_'
                assign note_file = ''
                assign note_art = note_key
                case note_key
                  when 'pink_pepper', 'black_pepper', 'sichuan_pepper'
                    assign note_art = 'pepper'
                  when 'cedarwood', 'virginia_cedar'
                    assign note_art = 'cedar'
                endcase
                case note_art
                  when 'lemon', 'cinnamon', 'vanilla', 'iris', 'lavender', 'orange', 'rose', 'cardamom', 'pepper', 'cedar', 'tobacco'
                    assign note_file = 'sample-scent-' | append: note_art | append: '.webp'
                endcase
                case note_key
                  when 'lemon'
                    assign note_tint = '#F2E27E'
                  when 'bergamot'
                    assign note_tint = '#E4E8B4'
                  when 'orange'
                    assign note_tint = '#F6D2A6'
                  when 'vanilla'
                    assign note_tint = '#EFE6D2'
                  when 'cinnamon'
                    assign note_tint = '#E2A07E'
                  when 'iris'
                    assign note_tint = '#DCD6E4'
                  when 'lavender'
                    assign note_tint = '#D8D0E8'
                  when 'rose'
                    assign note_tint = '#F0CBD0'
                  when 'cardamom'
                    assign note_tint = '#D5DDBA'
                  when 'pink_pepper', 'pepper', 'sichuan_pepper', 'black_pepper'
                    assign note_tint = '#F1CBC4'
                  when 'patchouli'
                    assign note_tint = '#CFC1A7'
                  when 'cedar', 'cedarwood', 'virginia_cedar'
                    assign note_tint = '#DCCAB0'
                  when 'tobacco'
                    assign note_tint = '#D9BC9C'
                  when 'amber'
                    assign note_tint = '#E9C99A'
                  when 'sage'
                    assign note_tint = '#D0D9C3'
                  when 'ambrette'
                    assign note_tint = '#EAD9CF'
                  else
                    assign note_tint = '#E6DFD4'
                endcase
              -%}
              {%- liquid
                # Real photos only: the merchant's own upload, else the bundled cut-out,
                # else the theme's licensed note photo (perfume-note-art, shown larger).
                # No photo at all: the note's name on its colour (no drawing).
                case note_index
                  when 0
                    assign note_upload = block.settings.note_image_1
                  when 1
                    assign note_upload = block.settings.note_image_2
                  else
                    assign note_upload = block.settings.note_image_3
                endcase
                assign note_photo = ''
                if note_upload == blank and note_file == blank
                  capture note_photo
                    render 'perfume-note-art', note: note_art
                  endcapture
                  if note_photo contains 'pf-note-photo'
                    assign note_photo = note_photo | replace: 'w=240&h=240', 'w=600&h=780' | replace: 'width="240" height="240"', 'width="600" height="780"'
                  else
                    assign note_photo = ''
                  endif
                endif
                assign note_kind = 'text'
                if note_upload != blank or note_photo != blank
                  assign note_kind = 'full'
                elsif note_file != blank
                  assign note_kind = 'cut'
                endif
                # How a cut-out sits: textures fill the card, stemmed flowers stand on
                # its bottom edge, everything else floats whole in the middle.
                assign note_fit = ''
                if note_kind == 'cut'
                  case note_art
                    when 'pepper', 'cinnamon'
                      assign note_fit = ' phh-note--fill'
                    when 'lavender', 'iris', 'rose'
                      assign note_fit = ' phh-note--stem'
                  endcase
                endif
              -%}
              <li class="phh-note phh-note--{{ note_kind }}{{ note_fit }}" data-for="{{ block.id }}" aria-hidden="true" style="--tile-bg: {{ note_tint }}; --j: {{ note_index }};">
                <span class="phh-note__media">
                  {%- if note_upload != blank -%}
                    {{ note_upload | image_url: width: 600 | image_tag: widths: '300, 450, 600', sizes: '(min-width: 990px) 12vw, 30vw', loading: 'lazy', alt: '' }}
                  {%- elsif note_file != blank -%}
                    <img class="phh-note__cut" src="{{ note_file | asset_url }}" alt="" loading="lazy">
                  {%- elsif note_photo != blank -%}
                    {{ note_photo }}
                  {%- endif -%}
                </span>
                <span class="phh-note__label"><span class="phh-note__kicker">Note</span><span class="phh-note__name">{{ note_name | capitalize | escape }}</span></span>
              </li>
              {%- assign note_index = note_index | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>

  {%- if section.settings.show_cursor -%}
    <div class="phh-cursor" data-phh-cursor aria-hidden="true">
      <span class="phh-cursor__label">{{ section.settings.cursor_label | escape }}</span>
    </div>
  {%- endif -%}
</perfume-hero>
{%- if section.settings.animate_intro -%}
  <script>
    (function () {
      var hero = document.getElementById('{{ sid }}');
      if (!hero || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      hero.classList.add('is-pre');
      document.documentElement.classList.add('pf-intro-pre');
      var loader = hero.querySelector('[data-phh-loader]');
      try {
        if (loader && !sessionStorage.getItem('pf-intro-seen')) loader.hidden = false;
      } catch (e) {}
      // Never leave the hero hidden if the script fails to load.
      setTimeout(function () {
        hero.classList.remove('is-pre');
        document.documentElement.classList.remove('pf-intro-pre');
        if (loader) loader.hidden = true;
      }, 4000);
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Perfume hero",
  "tag": "section",
  "class": "section-perfume-hero",
  "max_blocks": 7,
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "info": "Each line of this box becomes one line of the heading (and slides in on its own).",
      "default": "Authentic designer\nfragrances, picked\nby how they smell"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        }
      ],
      "default": "h1"
    },
    {
      "type": "text",
      "id": "accent",
      "label": "Handwritten accent",
      "default": "lemon, cinnamon & a little musk"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop fragrances"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Falls back to all products."
    },
    {
      "type": "text",
      "id": "button2_label",
      "label": "Second link label",
      "default": "Find your scent"
    },
    {
      "type": "url",
      "id": "button2_link",
      "label": "Second link"
    },
    {
      "type": "text",
      "id": "slogan",
      "label": "Slogan",
      "default": "Delivered across the Philippines"
    },
    {
      "type": "textarea",
      "id": "trust_points",
      "label": "Trust points",
      "info": "One per line, shown under the slogan with a check mark. Only claims that are true for your store (e.g. authenticity, payment, delivery)."
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size, desktop",
      "min": 40,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 84
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size, mobile",
      "min": 32,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 52
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "left_background",
      "label": "Left background",
      "default": "#F7F5F0"
    },
    {
      "type": "color",
      "id": "right_background",
      "label": "Right background",
      "default": "#E8E4DC"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#292521"
    },
    {
      "type": "header",
      "content": "Motion"
    },
    {
      "type": "checkbox",
      "id": "animate_intro",
      "label": "Animate on load",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_preloader",
      "label": "Show preloader (first visit per session)",
      "default": true
    },
    {
      "type": "color",
      "id": "preloader_color",
      "label": "Preloader bar",
      "default": "#3C3C3C"
    },
    {
      "type": "checkbox",
      "id": "float_tiles",
      "label": "Moving images",
      "info": "The tiles stay aligned; the image inside each one drifts or zooms very slowly. Off under reduced motion.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cursor",
      "label": "Dot cursor (mouse only)",
      "default": true
    },
    {
      "type": "text",
      "id": "cursor_label",
      "label": "Cursor label over linked tiles",
      "default": "View"
    },
    {
      "type": "select",
      "id": "intro_speed",
      "label": "Intro speed",
      "options": [
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "fast",
          "label": "Fast (about 40% shorter)"
        }
      ],
      "default": "normal"
    },
    {
      "type": "select",
      "id": "label_style",
      "label": "Tile labels",
      "options": [
        {
          "value": "spine",
          "label": "Vertical on the right edge, tile-coloured"
        },
        {
          "value": "bottom",
          "label": "Bottom-left over the image"
        }
      ],
      "default": "spine"
    },
    {
      "type": "checkbox",
      "id": "labels_on_touch",
      "label": "Bottom labels: always show on phones and touch screens",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Transparent PNG (bottle or ingredient cut-out), about 1200px tall."
        },
        {
          "type": "select",
          "id": "sample",
          "label": "Sample image (until an image is set)",
          "options": [
            {
              "value": "none",
              "label": "None"
            },
            {
              "value": "bottle-amber",
              "label": "Amber bottle"
            },
            {
              "value": "bottle-clear",
              "label": "Clear bottle"
            },
            {
              "value": "bottle-blue",
              "label": "Blue bottle"
            },
            {
              "value": "bottle-red",
              "label": "Red bottle"
            },
            {
              "value": "scent-lemon",
              "label": "Lemon"
            },
            {
              "value": "scent-cinnamon",
              "label": "Cinnamon"
            },
            {
              "value": "scent-vanilla",
              "label": "Vanilla"
            }
          ],
          "default": "none"
        },
        {
          "type": "select",
          "id": "image_fit",
          "label": "Image fit",
          "options": [
            {
              "value": "contain",
              "label": "Whole image (bottles)"
            },
            {
              "value": "cover",
              "label": "Fill the tile (ingredients)"
            }
          ],
          "default": "contain"
        },
        {
          "type": "select",
          "id": "image_position",
          "label": "Image position",
          "options": [
            {
              "value": "center",
              "label": "Centre"
            },
            {
              "value": "bottom-left",
              "label": "Bottom left"
            },
            {
              "value": "bottom-right",
              "label": "Bottom right"
            },
            {
              "value": "top-left",
              "label": "Top left"
            },
            {
              "value": "top-right",
              "label": "Top right"
            },
            {
              "value": "half-bottom",
              "label": "Half, rising from the bottom edge"
            },
            {
              "value": "half-left",
              "label": "Half, peeking in from the left"
            },
            {
              "value": "half-right",
              "label": "Half, peeking in from the right"
            }
          ],
          "default": "center"
        },
        {
          "type": "range",
          "id": "image_scale",
          "label": "Image size",
          "min": 40,
          "max": 200,
          "step": 5,
          "unit": "%",
          "default": 80,
          "info": "Over 100% crops the image at the tile edge. With Fill the tile it zooms in (close-up)."
        },
        {
          "type": "range",
          "id": "image_tilt",
          "label": "Image tilt",
          "min": -15,
          "max": 15,
          "step": 1,
          "unit": "deg",
          "default": 0
        },
        {
          "type": "color",
          "id": "background_color",
          "label": "Background",
          "default": "#E3CFA8"
        },
        {
          "type": "text",
          "id": "kicker",
          "label": "Small label",
          "info": "For example: Top note"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "info": "Shown on hover (desktop). Also the image's alt text."
        },
        {
          "type": "text",
          "id": "spine_text",
          "label": "Vertical label",
          "info": "Short text for the vertical label, e.g. Dior · Sauvage. Empty: small label · label."
        },
        {
          "type": "text",
          "id": "hover_notes",
          "label": "Notes shown on hover",
          "info": "Perfume tiles only: up to 3, comma-separated, from the brand's official list, e.g. bergamot, vanilla, patchouli. Hovering the tile shows them in place of the scent tiles."
        },
        { "type": "image_picker", "id": "note_image_1", "label": "Note 1 photo", "info": "Optional. Replaces the built-in photo of the first note." },
        { "type": "image_picker", "id": "note_image_2", "label": "Note 2 photo" },
        { "type": "image_picker", "id": "note_image_3", "label": "Note 3 photo" },
        {
          "type": "url",
