{%- comment -%}
  Perfume footer (NOHO-style). Put it in the footer group (sections/footer-group.json).

  Sand background, revealed from under the page as you scroll (the footer's content
  starts a little lower and settles as it comes into view). Top: a full-width email
  bar (Shopify customer form, tagged "newsletter"). Then columns (blocks: a menu or a
  text column), "Back to top" on the right, a giant wordmark across the full width
  whose letters rise in, and a bottom row with the legal menu, payment icons and a
  credit line.

  Script: assets/perfume-footer.js (<perfume-footer>). Styles: assets/perfume-footer.css.
{%- endcomment -%}
{%- liquid
  assign fid = 'PerfumeFooter-' | append: section.id
  assign atelier = false
  if section.settings.layout == 'atelier'
    assign atelier = true
  endif
  assign wordmark = section.settings.wordmark | default: shop.name
  assign wordmark_length = wordmark | size
  assign wm_logo = false
  if section.settings.wordmark_style == 'logo'
    assign wm_logo = true
    assign wm_words = wordmark | split: ' '
    assign wm_last = wm_words | last
    assign wm_prefix = wordmark | remove_last: wm_last | strip
    assign wm_last_len = wm_last | size
    assign wm_prefix_len = wm_prefix | size
    assign wordmark_length = wm_prefix_len | times: 0.4 | plus: wm_last_len | plus: 1.6
  endif
  if wordmark_length < 4
    assign wordmark_length = 4
  endif
-%}

{{ 'perfume-footer.css' | asset_url | stylesheet_tag }}
<script src="{{ 'perfume-footer.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  #{{ fid }} {
    --pfo-bg: {{ section.settings.background_color }};
    --pfo-ink: {{ section.settings.text_color }};
    --pfo-len: {{ wordmark_length }};
    --pfo-engrave-depth: {{ section.settings.wordmark_depth }}px;
  }
{%- endstyle -%}

<perfume-footer id="{{ fid }}" class="pfo{% if atelier %} pfo--atelier{% endif %}" data-wordmark-motion="{{ section.settings.wordmark_motion }}" data-wordmark-mist="{{ section.settings.wordmark_mist }}" data-reveal="{% if atelier %}false{% else %}{{ section.settings.reveal }}{% endif %}">
  <div class="pfo__inner" data-pfo-inner>
    <div class="pfo__upper">
      {%- if atelier -%}
        <div class="pfo__invitation">
          {%- if section.settings.heading != blank -%}
            <h2 class="pfo__heading">{{ section.settings.heading | escape | newline_to_br }}</h2>
          {%- endif -%}
          {%- if section.settings.intro != blank -%}<p class="pfo__intro">{{ section.settings.intro | escape }}</p>{%- endif -%}
          {%- if section.settings.discovery_link != blank and section.settings.discovery_label != blank -%}
            <a class="pfo__discovery pfo-link" href="{{ section.settings.discovery_link }}">{{ section.settings.discovery_label | escape }} <span aria-hidden="true">→</span></a>
          {%- endif -%}
        </div>
      {%- endif -%}
      <div class="pfo__content">
    {%- if section.settings.show_newsletter -%}
      {%- if atelier -%}
        <div class="pfo-news__intro">
          {%- if section.settings.newsletter_heading != blank -%}<h2 class="pfo-news__heading">{{ section.settings.newsletter_heading | escape }}</h2>{%- endif -%}
          {%- if section.settings.newsletter_text != blank -%}<p>{{ section.settings.newsletter_text | escape }}</p>{%- endif -%}
        </div>
      {%- endif -%}
      {%- form 'customer', id: 'PerfumeFooterNewsletter', class: 'pfo-news' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label class="pf-visually-hidden" for="PerfumeFooterEmail-{{ section.id }}">{{ section.settings.email_placeholder | escape }}</label>
        <input
          id="PerfumeFooterEmail-{{ section.id }}"
          class="pfo-news__input"
          type="email"
          name="contact[email]"
          autocomplete="email"
          autocorrect="off"
          autocapitalize="off"
          required
          placeholder="{{ section.settings.email_placeholder | escape }}"
          {% if form.errors %}aria-invalid="true" aria-describedby="PerfumeFooterNews-msg"{% endif %}
        >
        <button type="submit" class="pfo-news__button" aria-label="{{ section.settings.subscribe_label | escape }}">
          <span class="pfo-roll" aria-hidden="true"><span class="pfo-roll-in" data-text="{{ section.settings.subscribe_label | escape }}">{{ section.settings.subscribe_label | escape }}</span></span>
          {%- if atelier -%}<svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M3 10h14m-6-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.3"/></svg>{%- endif -%}
        </button>
        {%- if form.posted_successfully? -%}
          <p class="pfo-news__msg" id="PerfumeFooterNews-msg" role="status">{{ section.settings.success_message | escape }}</p>
        {%- elsif form.errors -%}
          <p class="pfo-news__msg pfo-news__msg--error" id="PerfumeFooterNews-msg" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
        {%- endif -%}
      {%- endform -%}
    {%- endif -%}

    <div class="pfo__cols">
      {%- for block in section.blocks -%}
        {%- assign menu_disclosure = false -%}
        {%- if atelier and section.settings.collapse_mobile_menus and block.type == 'menu' -%}
          {%- assign menu_disclosure = true -%}
        {%- endif -%}
        {%- if menu_disclosure -%}
        <details class="pfo-col pfo-col--menu" open data-pfo-menu {{ block.shopify_attributes }}>
          <summary class="pfo-col__heading"><span>{{ block.settings.heading | escape }}</span><svg class="pfo-col__toggle" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M8 3v10" fill="none" stroke="currentColor" stroke-width="1.2"/></svg></summary>
        {%- else -%}
        <div class="pfo-col" {{ block.shopify_attributes }}>
          {%- if block.settings.heading != blank -%}
            <p class="pfo-col__heading">{{ block.settings.heading | escape }}</p>
          {%- endif -%}
        {%- endif -%}
          {%- case block.type -%}
            {%- when 'menu' -%}
              <ul class="pfo-col__list" role="list">
                {%- for link in block.settings.menu.links -%}
                  <li><a class="pfo-link" href="{{ link.url }}" aria-label="{{ link.title | escape }}"><span class="pfo-roll" aria-hidden="true"><span class="pfo-roll-in" data-text="{{ link.title | escape }}">{{ link.title | escape }}</span></span></a></li>
                {%- endfor -%}
              </ul>
            {%- when 'text' -%}
              <div class="pfo-col__text">{{ block.settings.text }}</div>
          {%- endcase -%}
        {%- if menu_disclosure -%}</details>{%- else -%}</div>{%- endif -%}
      {%- endfor -%}

      {%- if section.settings.show_back_to_top and atelier == false -%}
        <a class="pfo-top pfo-link" href="#MainContent" data-pfo-top aria-label="{{ section.settings.back_to_top_label | escape }}">
          <span class="pfo-roll" aria-hidden="true"><span class="pfo-roll-in" data-text="{{ section.settings.back_to_top_label | escape }}">{{ section.settings.back_to_top_label | escape }}</span></span>
          <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M8 14V2M3 7l5-5 5 5" fill="none" stroke="currentColor" stroke-width="1.3"/></svg>
        </a>
      {%- endif -%}
    </div>
      </div>
    </div>

    {%- if wordmark != blank -%}
      <div class="pfo-signature" data-wordmark-hover="{% if section.settings.wordmark_deboss %}deboss{% else %}none{% endif %}">
      <p class="pfo-wordmark{% if wm_logo %} pfo-wordmark--logo{% endif %}" aria-hidden="true" data-pfo-wordmark>
        {%- assign chars = wordmark | split: '' -%}
        {%- if wm_logo -%}
          {%- if wm_prefix != blank -%}<span class="pfo-wordmark__pre"><span class="pfo-wordmark__glyph"><span class="pfo-wordmark__ink">{{ wm_prefix | escape }}</span><span class="pfo-wordmark__carved">{{ wm_prefix | escape }}</span></span></span>{%- endif -%}
          {%- assign chars = wm_last | split: '' -%}
        {%- endif -%}
        {%- for ch in chars -%}
          {%- if ch == ' ' -%}<span class="pfo-wordmark__space"> </span>{%- else -%}<span class="pfo-wordmark__ch" style="--i: {{ forloop.index0 }};"><span class="pfo-wordmark__glyph"><span class="pfo-wordmark__ink">{{ ch | escape }}</span><span class="pfo-wordmark__carved">{{ ch | escape }}</span></span></span>{%- endif -%}
        {%- endfor -%}
      </p>
      </div>
    {%- endif -%}

    <div class="pfo__bottom">
      <ul class="pfo__legal" role="list">
        <li>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}</li>
        {%- for link in section.settings.legal_menu.links -%}
          <li><a class="pfo-link" href="{{ link.url }}">{{ link.title | escape }}</a></li>
        {%- endfor -%}
      </ul>
      {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <ul class="pfo__payments" role="list">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'pfo__payment' }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if section.settings.credit != blank -%}
        <p class="pfo__credit">{{ section.settings.credit | escape }}</p>
      {%- endif -%}
      {%- if atelier and section.settings.show_back_to_top -%}
        <a class="pfo-top pfo-top--atelier pfo-link" href="#MainContent" data-pfo-top>
          <span>{{ section.settings.back_to_top_label | escape }}</span>
          <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M10 17V3M4 9l6-6 6 6" fill="none" stroke="currentColor" stroke-width="1.2"/></svg>
        </a>
      {%- endif -%}
    </div>
  </div>
</perfume-footer>

{% schema %}
{
  "name": "Perfume footer",
  "tag": "footer",
  "class": "section-perfume-footer",
  "enabled_on": {
    "groups": [
      "footer"
    ]
  },
  "max_blocks": 4,
  "settings": [
    { "type": "header", "content": "Design" },
    {
      "type": "select",
      "id": "layout",
      "label": "Footer design",
      "options": [
        { "value": "atelier", "label": "Editorial" },
        { "value": "classic", "label": "Original" }
      ],
      "default": "atelier"
    },
    { "type": "textarea", "id": "heading", "label": "Invitation heading", "default": "Your next\nsignature scent." },
    { "type": "text", "id": "intro", "label": "Invitation text", "default": "A new favourite starts with a little curiosity." },
    { "type": "text", "id": "discovery_label", "label": "Scent finder label", "default": "Not sure? Find your scent" },
    { "type": "url", "id": "discovery_link", "label": "Scent finder link" },
    { "type": "header", "content": "Newsletter" },
    { "type": "text", "id": "newsletter_heading", "label": "Newsletter heading", "default": "Stay in the notes." },
    { "type": "text", "id": "newsletter_text", "label": "Newsletter text", "default": "New arrivals and scent notes, in your inbox." },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show email signup", "info": "Signups become customers tagged newsletter (Customers in Shopify admin).", "default": true },
    { "type": "text", "id": "email_placeholder", "label": "Email placeholder", "default": "Your email, for new arrivals and scent notes" },
    { "type": "text", "id": "subscribe_label", "label": "Button label", "default": "Subscribe" },
    { "type": "text", "id": "success_message", "label": "Thank-you message", "default": "Thank you. You're on the list." },
    { "type": "header", "content": "Layout" },
    { "type": "checkbox", "id": "collapse_mobile_menus", "label": "Collapse menus on phones", "default": true },
    { "type": "checkbox", "id": "show_back_to_top", "label": "Show Back to top", "default": true },
    { "type": "text", "id": "back_to_top_label", "label": "Back to top label", "default": "Back to top" },
    { "type": "text", "id": "wordmark", "label": "Giant wordmark", "info": "Fills the footer's width. Falls back to the store name.", "default": "eau de samyó" },
    { "type": "select", "id": "wordmark_motion", "label": "Wordmark entrance", "options": [{ "value": "none", "label": "No animation" }, { "value": "prefix", "label": "Prefix first (idea 5)" }], "default": "prefix" },
    { "type": "checkbox", "id": "wordmark_deboss", "label": "Pressed-in wordmark on hover", "default": true },
    { "type": "checkbox", "id": "wordmark_mist", "label": "Perfume mist on wordmark hover", "default": true },
    { "type": "range", "id": "wordmark_depth", "label": "Engraving depth", "min": 0.5, "max": 4, "step": 0.5, "unit": "px", "default": 2 },
    {
      "type": "select",
      "id": "wordmark_style",
      "label": "Wordmark lettering",
      "options": [
        { "value": "logo", "label": "Like the logo (italic prefix, Italiana last word)" },
        { "value": "serif", "label": "All in the serif" }
      ],
      "default": "logo"
    },
    { "type": "link_list", "id": "legal_menu", "label": "Legal menu", "default": "footer" },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true },
    { "type": "text", "id": "credit", "label": "Credit line", "default": "Authentic fragrances, delivered across the Philippines" },
    { "type": "checkbox", "id": "reveal", "label": "Reveal from under the page on scroll", "default": true },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#D8D1C5" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#292521" }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" }
      ]
    },
    {
      "type": "text",
      "name": "Text column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Contact us" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>hello@samyo.shop<br>Mon–Sat, 10am–7pm (PHT)</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Perfume footer",
      "blocks": [
        {
          "type": "text",
          "settings": { "heading": "Contact us" }
        },
        {
          "type": "menu",
          "settings": { "heading": "Shop", "menu": "main-menu" }
        },
        {
          "type": "menu",
          "settings": { "heading": "Help", "menu": "footer" }
        }
      ]
    }
  ]
}
{% endschema %}
