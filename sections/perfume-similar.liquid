{%- comment -%}
  Similar fragrances: "If you love this, explore these."
  Transparent matching (shown under the cards, documented in docs/METAFIELDS.md):
  for each perfume in the chosen collection, 3 points per shared note, 2 for the same
  family, 1 per shared characteristic (Scent DNA) and 1 per shared occasion. Highest
  first; each card says what it shares. Manual picks (profile.related) come first as
  "Our pick". Perfumes with nothing in common don't show.

  Scored in Liquid (crawlable). CSS `order` ranks them without JS; JS only keeps the
  best few and offers "Show more". Cards: snippets/perfume-product-card.liquid.
{%- endcomment -%}
{%- liquid
  assign profile = metaobject
  if profile == blank
    assign profile = product.metafields.fragrance.profile.value
  endif
  assign sid = 'PerfumeSimilar-' | append: section.id
  assign name = profile.name.value | default: product.title
  assign tints = section.settings.tints | split: ','

  assign cur_notes = ','
  for list in (1..3)
    case list
      when 1
        assign group = profile.top_notes.value | default: product.metafields.fragrance.top_notes.value
      when 2
        assign group = profile.middle_notes.value | default: product.metafields.fragrance.middle_notes.value
      else
        assign group = profile.base_notes.value | default: product.metafields.fragrance.base_notes.value
    endcase
    for nn in group
      assign nk = nn.name.value | default: nn | downcase | strip
      assign cur_notes = cur_notes | append: nk | append: ','
    endfor
  endfor
  assign cur_family = profile.family.value | default: product.metafields.fragrance.fragrance_family.value | downcase
  assign cur_accords = ','
  for t in profile.characteristics.value
    assign ak = t.accord.value | downcase
    assign cur_accords = cur_accords | append: ak | append: ','
  endfor
  assign cur_occ = profile.occasions.value | join: ',' | downcase | prepend: ',' | append: ','

  assign pool = section.settings.collection.products
  if pool == blank or pool.size == 0
    assign pool = collections.all.products
  endif
  assign shown = 0
-%}

{{ 'perfume-discovery.css' | asset_url | stylesheet_tag }}
{{ 'perfume-card.css' | asset_url | stylesheet_tag }}
<script src="{{ 'perfume-card.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'perfume-discovery.js' | asset_url }}" defer="defer"></script>

{%- capture cards -%}
  {%- for pick in profile.related.value -%}
    {%- assign pick_product = pick.products.value.first -%}
    {%- if pick_product != blank and pick_product.id != product.id -%}
      {%- assign shown = shown | plus: 1 -%}
      <li class="psim__item" style="order: 0;" data-score="999">
        {%- render 'perfume-product-card', product: pick_product, bg: tints[0], quick_add: section.settings.quick_add, key: section.id, sizes: '(min-width: 990px) 25vw, 50vw' -%}
        <p class="psim__why"><b>{{ section.settings.pick_label | escape }}</b></p>
      </li>
    {%- endif -%}
  {%- endfor -%}

  {%- for p in pool limit: 60 -%}
    {%- if p.id == product.id -%}{%- continue -%}{%- endif -%}
    {%- liquid
      assign cp = p.metafields.fragrance.profile.value
      assign cname = cp.name.value | default: p.title
      if cname == name
        continue
      endif
      assign score = 0
      assign why_notes = ''
      for list in (1..3)
        case list
          when 1
            assign group = cp.top_notes.value | default: p.metafields.fragrance.top_notes.value
          when 2
            assign group = cp.middle_notes.value | default: p.metafields.fragrance.middle_notes.value
          else
            assign group = cp.base_notes.value | default: p.metafields.fragrance.base_notes.value
        endcase
        for nn in group
          assign nk = nn.name.value | default: nn | downcase | strip
          assign probe = ',' | append: nk | append: ','
          if cur_notes contains probe
            unless why_notes contains nk
              assign score = score | plus: 3
              if why_notes != blank
                assign why_notes = why_notes | append: ', '
              endif
              assign why_notes = why_notes | append: nk
            endunless
          endif
        endfor
      endfor
      assign same_family = false
      assign c_family = cp.family.value | default: p.metafields.fragrance.fragrance_family.value | downcase
      if c_family != blank and c_family == cur_family
        assign score = score | plus: 2
        assign same_family = true
      endif
      assign why_accords = ''
      for t in cp.characteristics.value
        assign ak = t.accord.value | downcase
        assign probe = ',' | append: ak | append: ','
        if cur_accords contains probe
          assign score = score | plus: 1
          if why_accords != blank
            assign why_accords = why_accords | append: ', '
          endif
          assign why_accords = why_accords | append: ak
        endif
      endfor
      for o in cp.occasions.value
        assign ok = o | downcase
        assign probe = ',' | append: ok | append: ','
        if cur_occ contains probe
          assign score = score | plus: 1
        endif
      endfor
      assign t_index = forloop.index0 | modulo: tints.size
      assign t = tints[t_index] | strip
      assign card_key = section.id | append: '-' | append: forloop.index
      assign order = 900 | minus: score
    -%}
    {%- if score > 0 -%}
      {%- assign shown = shown | plus: 1 -%}
      <li class="psim__item" style="order: {{ order }};" data-score="{{ score }}">
        {%- render 'perfume-product-card', product: p, bg: t, quick_add: section.settings.quick_add, key: card_key, sizes: '(min-width: 990px) 25vw, 50vw' -%}
        <p class="psim__why">
          {%- if why_notes != blank -%}<span><b>Shares</b> {{ why_notes | escape }}</span>{%- endif -%}
          {%- if same_family -%}<span><b>Same family</b> {{ c_family | capitalize | escape }}</span>{%- endif -%}
          {%- if why_accords != blank -%}<span><b>Both</b> {{ why_accords | escape }}</span>{%- endif -%}
        </p>
      </li>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- if shown > 0 or request.design_mode -%}
  <perfume-similar id="{{ sid }}" class="psim" data-limit="{{ section.settings.limit }}" style="--psim-bg: {{ section.settings.background_color }}; --psim-ink: {{ section.settings.text_color }};">
    <span class="pd-anchor" id="similar"></span>
    <div class="pd-head">
      <p class="pd-kicker">{{ section.settings.kicker | escape }}</p>
      <h2 class="pd-h">{{ section.settings.heading | replace: '[name]', name | escape }}</h2>
    </div>
    {%- if shown > 0 -%}
      <ul class="psim__grid" role="list" data-psim-list>{{ cards }}</ul>
      <button type="button" class="psim__more" data-psim-more hidden>{{ section.settings.more_label | escape }}</button>
    {%- else -%}
      <p class="pd-basis">No matches yet: add notes to the perfumes' profiles.</p>
    {%- endif -%}
    <p class="pd-basis">{{ section.settings.method_note | escape }}</p>
  </perfume-similar>
{%- endif -%}

{% schema %}
{
  "name": "Similar fragrances",
  "tag": "div",
  "class": "section-perfume-similar",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "You might also like" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "[name] becomes the fragrance name.", "default": "If you love this, explore these" },
    { "type": "collection", "id": "collection", "label": "Look for matches in", "info": "Falls back to all products. Up to 60 are compared." },
    { "type": "range", "id": "limit", "label": "Matches shown", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "quick_add", "label": "Quick Add button", "default": true },
    { "type": "text", "id": "pick_label", "label": "Manual pick label", "default": "Our pick" },
    { "type": "text", "id": "more_label", "label": "Show more label", "default": "Show more matches" },
    {
      "type": "text",
      "id": "method_note",
      "label": "How matching works",
      "default": "How we match: 3 points per shared note, 2 for the same family, 1 per shared characteristic and 1 per shared occasion. Highest first."
    },
    { "type": "text", "id": "tints", "label": "Card colours", "default": "#D6DDE5, #EAD8C2, #E9D3C9, #DFD9E6" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F3F0EB" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#26221F" }
  ],
  "presets": [{ "name": "Similar fragrances" }]
}
{% endschema %}
