{%- comment -%}
  Vial picker ("Build your set", templates/page.decant-builder.json).

  1. Choose a set (blocks "set": e.g. 3 × 1 ml).
  2. Pick a scent for every vial. A set starts filled with the cheapest different
     scents (its lowest price); picked scents fade in the grid and their button
     removes them. Scents come from a collection (setting
     "collection", else all products); a perfume is offered in a size when it has a
     variant for it: any option value "1 ml", "2 ml", "5 ml" or "10 ml".
  3. Add to bag (then the cart drawer opens): one line per picked vial (that perfume's size variant, at its own
     price), all marked with the set, e.g. "Set: Try trio · 3 × 1 ml", plus a hidden
     "_set" id so two identical sets stay apart.

  The set's price is the sum of the vials picked: three different perfumes give
  their three prices added up, less the set's discount (block setting; the matching
  automatic discount must exist in Shopify). Set cards show the range: the cheapest
  and dearest different scents (or one scent repeated, when repeats are allowed).
  Vial prices: dev/decant-pricing.html, section 2b.

  Open with a set chosen: ?set=3x1 (count x size). The homepage Decants bundles can
  link here that way. ?scent=<product handle> puts that perfume in the set first (the
  product page's "Build a set with this scent" link).

  Without JavaScript the sets and scents still show, with a note to enable it.
  Styles: assets/perfume-vial-picker.css. Script: assets/perfume-vial-picker.js.
{%- endcomment -%}
{%- liquid
  assign vid = 'VialPicker-' | append: section.id
  assign sets = section.blocks | where: 'type', 'set'
  assign pool = section.settings.collection.products
  if pool == blank or pool.size == 0
    assign pool = collections.all.products
  endif
  assign vial_sizes = '1,2,5,10' | split: ','
-%}

{{ 'perfume-vial-picker.css' | asset_url | stylesheet_tag }}
<script src="{{ 'perfume-vial-picker.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  #{{ vid }} {
    --pvp-bg: {{ section.settings.background_color }};
    --pvp-ink: {{ section.settings.text_color }};
    --pvp-card: {{ section.settings.card_color }};
    --pvp-pt: {{ section.settings.padding_top }}px;
    --pvp-pb: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<section
  id="{{ vid }}"
  class="pvp{% if section.settings.card_style == 'compact' %} pvp--compact{% endif %}"
  aria-labelledby="{{ vid }}-h"
  data-pvp
  data-repeats="{{ section.settings.allow_repeats }}"
  data-currency="{{ cart.currency.iso_code | default: shop.currency }}"
  data-cart-add="{{ routes.cart_add_url }}"
  data-cart="{{ routes.cart_url }}"
  data-vial-1="{{ 'sample-decant-square.webp' | asset_url }}"
  data-vial-2="{{ 'sample-decant-clear.webp' | asset_url }}"
  data-vial-5="{{ 'sample-decant-amber.webp' | asset_url }}"
  data-vial-10="{{ 'sample-decant-amber.webp' | asset_url }}"
  data-t-picked="{{ section.settings.picked_label | escape }}"
  data-t-full="{{ section.settings.full_label | escape }}"
  data-t-empty="{{ section.settings.empty_label | escape }}"
  data-t-remove="{{ section.settings.remove_label | escape }}"
  data-t-add-scent="{{ section.settings.add_scent_label | escape }}"
  data-t-per-vial="{{ section.settings.per_vial_label | escape }}"
  data-t-filled="{{ section.settings.filled_label | escape }}"
  data-t-pop-add="{{ section.settings.pop_add_label | escape }}"
  data-t-pop-remove="{{ section.settings.pop_remove_label | escape }}"
  data-t-bar="{{ section.settings.bar_count_label | escape }}"
  data-t-less="{{ section.settings.less_label | escape }}"
  data-t-unavailable="{{ section.settings.unavailable_label | escape }}"
  data-t-error="{{ section.settings.error_label | escape }}"
  data-t-added="{{ section.settings.added_label | escape }}"
  data-t-discount="{{ section.settings.discount_label | escape }}"
  data-t-from="{{ section.settings.range_from_label | escape }}"
  data-t-to="{{ section.settings.range_to_label | escape }}"
>
  <div class="pvp__wrap">
    <header class="pvp__head">
      {%- if section.settings.kicker != blank -%}<p class="pf-kicker">{{ section.settings.kicker | escape }}</p>{%- endif -%}
      <h1 class="pvp__h" id="{{ vid }}-h">{{ section.settings.heading | escape }}{% if section.settings.heading_italic != blank %} <em>{{ section.settings.heading_italic | escape }}</em>{% endif %}</h1>
      {%- if section.settings.text != blank -%}<div class="pvp__text">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.settings.show_size_guide -%}
        {%- render 'perfume-vial-size', id: section.id, class: 'pvp__size-guide' -%}
      {%- endif -%}
    </header>

    <noscript><p class="pvp__hint">{{ section.settings.nojs_label | escape }}</p></noscript>

    <div class="pvp__grid">
      <div class="pvp__main">
        {%- comment -%} Step 1: the set {%- endcomment -%}
        <fieldset class="pvp__step">
          <legend class="pvp__legend"><span>1</span>{{ section.settings.step1_label | escape }}</legend>
          {%- if sets.size > 0 -%}
            <div class="pvp__sets">
              {%- for s in sets -%}
                {%- assign key = s.settings.count | append: 'x' | append: s.settings.size -%}
                <label class="pvp__set" {{ s.shopify_attributes }}>
                  <input
                    type="radio"
                    name="{{ vid }}-set"
                    value="{{ key }}"
                    data-count="{{ s.settings.count }}"
                    data-size="{{ s.settings.size }}"
                    data-discount="{{ s.settings.discount }}"
                    data-title="{{ s.settings.title | escape }}{% if s.settings.title_italic != blank %} {{ s.settings.title_italic | escape }}{% endif %}"
                    {% if forloop.first %}checked{% endif %}
                  >
                  {%- liquid
                    case s.settings.size
                      when '1'
                        assign v_img = 'sample-decant-square.webp'
                        assign v_h = 44
                      when '2'
                        assign v_img = 'sample-decant-clear.webp'
                        assign v_h = 62
                      when '5'
                        assign v_img = 'sample-decant-amber.webp'
                        assign v_h = 82
                      else
                        assign v_img = 'sample-decant-amber.webp'
                        assign v_h = 100
                    endcase
                    assign v_shown = s.settings.count | at_most: 6
                  -%}
                  <span class="pvp__set-box">
                    <span class="pvp__set-check" aria-hidden="true"></span>
                    {%- if s.settings.badge != blank -%}<span class="pvp__badge">{{ s.settings.badge | escape }}</span>{%- endif -%}
                    <span class="pvp__set-vials" style="--vh: {{ v_h }}%;" data-n="{{ v_shown }}" aria-hidden="true">
                      {%- for i in (1..v_shown) -%}
                        <img src="{{ v_img | asset_url }}" alt="" width="40" height="160" loading="lazy" style="--i: {{ forloop.index0 }};">
                      {%- endfor -%}
                    </span>
                    <span class="pvp__set-name">{{ s.settings.title | escape }}{% if s.settings.title_italic != blank %} <em>{{ s.settings.title_italic | escape }}</em>{% endif %}</span>
                    <span class="pvp__set-what">{{ s.settings.count }} × {{ s.settings.size }} ml</span>
                    <span class="pvp__set-price"><span class="pvp__set-from" data-range-lo></span><span class="pvp__set-to" data-range-hi></span></span>
                  </span>
                </label>
              {%- endfor -%}
            </div>
            {%- if section.settings.pricing_note != blank -%}<p class="pvp__note">{{ section.settings.pricing_note | escape }}</p>{%- endif -%}
          {%- elsif request.design_mode -%}
            <p class="pvp__hint">Add Set blocks, e.g. 3 × 1 ml.</p>
          {%- endif -%}
        </fieldset>

        {%- comment -%} Step 2: the scents, each with its own price per vial {%- endcomment -%}
        <fieldset class="pvp__step">
          <legend class="pvp__legend"><span>2</span>{{ section.settings.step2_label | escape }}</legend>
          {%- if section.settings.swap_note != blank -%}
            <p class="pvp__swap"><span class="pvp__swap-icon" aria-hidden="true">i</span><span>{{ section.settings.swap_note | escape }}</span></p>
          {%- endif -%}
          {%- if section.settings.show_fills -%}
            {%- if section.settings.show_gender_filter -%}
              <div class="pvp__fills pvp__gf" role="group" aria-label="{{ section.settings.gf_label | escape }}" data-gf hidden>
                <span class="pvp__fills-t">{{ section.settings.gf_label | escape }}</span>
                <button type="button" class="pvp__fill" data-gf-v="" aria-pressed="true">{{ section.settings.gf_all_label | escape }}</button>
                {%- if section.settings.gf_men_label != blank -%}<button type="button" class="pvp__fill" data-gf-v="men" aria-pressed="false"><i class="pvp__gf-dot pvp__gf-dot--men" aria-hidden="true"></i>{{ section.settings.gf_men_label | escape }}<span class="pvp__gf-n" data-gf-n></span></button>{%- endif -%}
                {%- if section.settings.gf_women_label != blank -%}<button type="button" class="pvp__fill" data-gf-v="women" aria-pressed="false"><i class="pvp__gf-dot pvp__gf-dot--women" aria-hidden="true"></i>{{ section.settings.gf_women_label | escape }}<span class="pvp__gf-n" data-gf-n></span></button>{%- endif -%}
                {%- if section.settings.gf_unisex_label != blank -%}<button type="button" class="pvp__fill" data-gf-v="unisex" aria-pressed="false"><i class="pvp__gf-dot pvp__gf-dot--unisex" aria-hidden="true"></i>{{ section.settings.gf_unisex_label | escape }}<span class="pvp__gf-n" data-gf-n></span></button>{%- endif -%}
              </div>
            {%- endif -%}
            <div class="pvp__fills" role="group" aria-label="{{ section.settings.fills_label | escape }}" data-fills>
              <span class="pvp__fills-t">{{ section.settings.fills_label | escape }}</span>
              {%- if section.settings.fill_low_label != blank -%}<button type="button" class="pvp__fill" data-fill="low"><span aria-hidden="true">₱</span>{{ section.settings.fill_low_label | escape }}</button>{%- endif -%}
              {%- if section.settings.fill_brand_label != blank -%}<button type="button" class="pvp__fill" data-fill="brand"><span aria-hidden="true">◎</span>{{ section.settings.fill_brand_label | escape }}</button>{%- endif -%}
              {%- if section.settings.fill_surprise_label != blank -%}<button type="button" class="pvp__fill" data-fill="surprise"><span aria-hidden="true">✦</span>{{ section.settings.fill_surprise_label | escape }}</button>{%- endif -%}
            </div>
          {%- endif -%}
          <ul class="pvp__scents" role="list" data-scents>
            {%- assign shown = 0 -%}
            {%- for p in pool limit: 100 -%}
              {%- capture vials -%}
                {%- for z in vial_sizes -%}
                  {%- assign want = z | append: 'ml' -%}
                  {%- for v in p.variants -%}
                    {%- assign o1 = v.option1 | downcase | remove: ' ' -%}
                    {%- assign o2 = v.option2 | downcase | remove: ' ' -%}
                    {%- assign o3 = v.option3 | downcase | remove: ' ' -%}
                    {%- if o1 == want or o2 == want or o3 == want -%}
                      {{- z }}:{{ v.id }}:{{ v.price }}:{{ v.available }};
                      {%- break -%}
                    {%- endif -%}
                  {%- endfor -%}
                {%- endfor -%}
              {%- endcapture -%}
              {%- if vials == blank -%}{%- continue -%}{%- endif -%}
              {%- assign shown = shown | plus: 1 -%}
              {%- assign media = p.featured_media -%}
              <li class="pvp__scent" data-scent="{{ p.title | escape }}" data-handle="{{ p.handle | escape }}" data-vendor="{{ p.vendor | escape }}" data-vials="{{ vials | strip }}">
                <span class="pvp__num" data-num aria-hidden="true" hidden></span>
                {%- if section.settings.pop_notes -%}
                  {%- comment -%} Pop-up note pictures (owner 2026-11-26): the perfume's own notes, top → base, never invented. {%- endcomment -%}
                  {%- liquid
                    assign n_profile = p.metafields.fragrance.profile.value
                    assign n_top = n_profile.top_notes.value | default: p.metafields.fragrance.top_notes.value
                    assign n_mid = n_profile.middle_notes.value | default: p.metafields.fragrance.middle_notes.value
                    assign n_base = n_profile.base_notes.value | default: p.metafields.fragrance.base_notes.value
                    assign n_count = 0
                  -%}
                  <template data-notes>
                    {%- for list in (1..3) -%}
                      {%- liquid
                        case list
                          when 1
                            assign n_group = n_top
                          when 2
                            assign n_group = n_mid
                          else
                            assign n_group = n_base
                        endcase
                      -%}
                      {%- for note in n_group -%}
                        {%- if n_count >= 5 -%}{%- break -%}{%- endif -%}
                        {%- assign n_count = n_count | plus: 1 -%}
                        {%- assign n_name = note.name.value | default: note -%}
                        {%- assign n_art = note.art.value | default: n_name -%}
                        <span class="pvp__pn" data-name="{{ n_name | escape }}" data-i="{{ n_name | slice: 0 | upcase | escape }}">
                          {%- if note.image.value != blank -%}
                            {{ note.image.value | image_url: width: 120 | image_tag: alt: '', loading: 'lazy' }}
                          {%- else -%}
                            {%- render 'perfume-note-art', note: n_art -%}
                          {%- endif -%}
                        </span>
                      {%- endfor -%}
                    {%- endfor -%}
                  </template>
                {%- endif -%}
                <span class="pvp__scent-img" aria-hidden="true">
                  {%- if media != blank -%}
                    {{ media.preview_image | image_url: width: 400 | image_tag: widths: '200, 300, 400', sizes: '(min-width: 990px) 15vw, 40vw', alt: '', loading: 'lazy' }}
                  {%- else -%}
                    {%- comment -%} No product photo yet: the brand name, never a stand-in bottle. {%- endcomment -%}
                    <span class="pvp__scent-mono">{{ p.vendor | default: p.title | escape }}</span>
                  {%- endif -%}
                </span>
                {%- comment -%}
                  Who it's made for, from the product's own data only: a tag "men", "women"
                  or "unisex" (also "for men", "for women"), else Shopify's Target gender
                  category metafield. Nothing shows when neither is set.
                {%- endcomment -%}
                {%- assign for_key = '' -%}
                {%- for tg in p.tags -%}
                  {%- assign tk = tg | downcase | remove: 'for ' | strip -%}
                  {%- if tk == 'men' or tk == 'women' or tk == 'unisex' -%}{%- assign for_key = tk -%}{%- break -%}{%- endif -%}
                {%- endfor -%}
                {%- if for_key == blank -%}
                  {%- assign tgs = p.metafields.shopify['target-gender'].value -%}
                  {%- if tgs.size == 1 -%}
                    {%- assign tl = tgs.first.label | downcase -%}
                    {%- if tl == 'male' -%}{%- assign for_key = 'men' -%}{%- elsif tl == 'female' -%}{%- assign for_key = 'women' -%}{%- elsif tl == 'unisex' -%}{%- assign for_key = 'unisex' -%}{%- endif -%}
                  {%- elsif tgs.size > 1 -%}
                    {%- assign for_key = 'unisex' -%}
                  {%- endif -%}
                {%- endif -%}
                {%- if for_key != blank -%}
                  {%- case for_key -%}
                    {%- when 'men' -%}{%- assign for_label = section.settings.for_men_label -%}
                    {%- when 'women' -%}{%- assign for_label = section.settings.for_women_label -%}
                    {%- else -%}{%- assign for_label = section.settings.for_unisex_label -%}
                  {%- endcase -%}
                  {%- if for_label != blank -%}
                    <span class="pvp__for pvp__for--{{ for_key }}">
                      {%- comment -%} Gender icon (owner 2026-11-26): ♂ men, ♀ women, both for unisex. {%- endcomment -%}
                      <svg class="pvp__for-ic" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        {%- case for_key -%}
                          {%- when 'men' -%}<circle cx="10" cy="14" r="5.5"/><path d="M14 10l6-6M15 4h5v5"/>
                          {%- when 'women' -%}<circle cx="12" cy="9" r="5.5"/><path d="M12 14.5V21M9 18h6"/>
                          {%- else -%}<circle cx="11" cy="11" r="4.5"/><path d="M14.3 7.7 19 3M15.5 3H19v3.5M11 15.5V21M8.5 18.5h5"/>
                        {%- endcase -%}
                      </svg>
                      <span class="pvp__for-t">{{ for_label | escape }}</span>
                    </span>
                  {%- endif -%}
                {%- endif -%}
                <span class="pvp__scent-vendor">{{ p.vendor | escape }}</span>
                <span class="pvp__scent-name">{{ p.title | escape }}</span>
                <span class="pvp__vial-price" data-vial-price></span>
                <button type="button" class="pvp__add" data-add aria-label="{{ section.settings.add_scent_label | escape }}: {{ p.title | escape }}">
                  <span aria-hidden="true" data-add-icon>+</span> <span data-add-text>{{ section.settings.add_scent_label | escape }}</span>
                </button>
                <span class="pvp__tip" id="{{ vid }}-tip-{{ forloop.index }}" role="tooltip" data-tip hidden>{{ section.settings.full_tip_label | escape }}</span>
                <span class="pvp__count" data-count hidden></span>
              </li>
            {%- endfor -%}
            {%- if shown == 0 -%}
              <li class="pvp__hint">No scents to show yet. Give each perfume decant size variants (1 ml, 2 ml, 5 ml, 10 ml){% if section.settings.collection != blank %} in the chosen collection{% endif %}.</li>
            {%- endif -%}
          </ul>
        </fieldset>
      </div>

      {%- comment -%} The tray: your vials, each with its price, and the total {%- endcomment -%}
      <aside class="pvp__tray" aria-labelledby="{{ vid }}-tray">
        {%- comment -%} Phones: a bar that opens the tray as a drawer (perfume-vial-picker.js). {%- endcomment -%}
        <button type="button" class="pvp__bar" data-bar aria-expanded="false" aria-controls="{{ vid }}-body">
          <span class="pvp__bar-vials" data-bar-vials aria-hidden="true"></span>
          <span class="pvp__bar-text"><b data-bar-total></b><span data-bar-n></span></span>
          <span class="pvp__bar-label">{{ section.settings.tray_label | escape }}</span>
          <span class="pvp__bar-chev" aria-hidden="true"></span>
        </button>
        <div class="pvp__tray-body" id="{{ vid }}-body" data-tray-body><div class="pvp__tray-in">
        <h2 class="pvp__tray-h" id="{{ vid }}-tray">{{ section.settings.tray_label | escape }}</h2>
        <p class="pvp__tray-set" data-set-name></p>
        <ol class="pvp__slots" data-slots role="list"></ol>
        <p class="pvp__status" data-status aria-live="polite"></p>
        <form method="post" action="{{ routes.cart_add_url }}" class="pvp__form" data-form>
          <p class="pvp__line" data-sub-line hidden><span>{{ section.settings.subtotal_label | escape }}</span><span data-sub></span></p>
          <p class="pvp__line" data-off-line hidden><span data-off-label></span><span data-off></span></p>
          <p class="pvp__total"><span>{{ section.settings.total_label | escape }}</span><b data-total></b></p>
          <button type="submit" class="pvp__submit" data-submit disabled>{{ section.settings.add_label | escape }}</button>
        </form>
        {%- if section.settings.trust != blank -%}<p class="pvp__trust">{{ section.settings.trust | escape }}</p>{%- endif -%}
        </div></div>
      </aside>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Vial picker",
  "tag": "div",
  "class": "section-perfume-vial-picker",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Decants" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Build your" },
    { "type": "text", "id": "heading_italic", "label": "Heading, italic part", "default": "set" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Choose a set, then pick a scent for every vial. Poured by hand from authentic full bottles.</p>" },
    { "type": "checkbox", "id": "show_size_guide", "label": "Show the vial size guide", "info": "Vials at actual size. Heights: Theme settings → Sangyó vial sizes.", "default": false },
    { "type": "collection", "id": "collection", "label": "Scents to choose from", "info": "Leave empty to use all products. A perfume shows in a size when it has a variant for it, e.g. 1 ml." },
    { "type": "checkbox", "id": "allow_repeats", "label": "Allow the same scent more than once", "info": "Off: every vial in a set is a different scent, and set prices show the cheapest and dearest different scents.", "default": false },
    { "type": "header", "content": "Labels" },
    { "type": "text", "id": "step1_label", "label": "Step 1", "default": "Choose your set" },
    { "type": "text", "id": "range_from_label", "label": "Set price: lowest", "info": "[price] = the cheapest different scents.", "default": "from [price]" },
    { "type": "text", "id": "range_to_label", "label": "Set price: highest", "info": "[price] = the dearest different scents.", "default": "up to [price]" },
    { "type": "text", "id": "pricing_note", "label": "Pricing note under the sets", "default": "Each perfume has its own price per vial. Your set costs the vials you pick, added up." },
    { "type": "text", "id": "step2_label", "label": "Step 2", "default": "Pick your scents" },
    { "type": "textarea", "id": "swap_note", "label": "Note above the scents", "info": "Explains that the starting scents can be changed. Empty hides it.", "default": "Pre-filled with our lowest-priced scents. Click a picked one to take it out, then pick any other." },
    { "type": "text", "id": "per_vial_label", "label": "Price on each scent", "info": "[price] = one vial in the chosen size, [size] = the size.", "default": "[price] per [size] ml vial" },
    {
      "type": "select",
      "id": "card_style",
      "label": "Scent cards",
      "options": [
        { "value": "compact", "label": "Compact tiles (photo only, details on hover)" },
        { "value": "cards", "label": "Full cards" }
      ],
      "default": "compact",
      "info": "Compact matches the Try trio grid on product pages. On touch screens the tiles show a short name and price."
    },
    { "type": "checkbox", "id": "pop_notes", "label": "Pop-up: show note pictures", "default": true, "info": "Up to five of the perfume's notes (top, heart, base) resting on the photo. Perfumes without notes just show the photo." },
    { "type": "text", "id": "pop_add_label", "label": "Pop-up: add", "default": "Click to add" },
    { "type": "text", "id": "pop_remove_label", "label": "Pop-up: remove", "default": "Click to take it out" },
    { "type": "checkbox", "id": "show_fills", "label": "Show quick fill buttons", "info": "One tap fills the set: lowest price, one of each brand, or a random mix.", "default": true },
    { "type": "text", "id": "fills_label", "label": "Quick fill heading", "default": "Quick fill" },
    { "type": "checkbox", "id": "show_gender_filter", "label": "Show the Men / Women / Unisex filter", "default": false, "info": "Uses the same tags as the labels below (men, women, unisex). Buttons with no perfumes hide themselves." },
    { "type": "text", "id": "gf_label", "label": "Filter heading", "default": "Show" },
    { "type": "text", "id": "gf_all_label", "label": "Filter: all", "default": "All" },
    { "type": "text", "id": "gf_men_label", "label": "Filter: men", "default": "Men" },
    { "type": "text", "id": "gf_women_label", "label": "Filter: women", "default": "Women" },
    { "type": "text", "id": "gf_unisex_label", "label": "Filter: unisex", "default": "Unisex" },
    { "type": "text", "id": "fill_low_label", "label": "Quick fill: lowest price", "info": "Empty hides this button.", "default": "Lowest price" },
    { "type": "text", "id": "fill_brand_label", "label": "Quick fill: one of each brand", "default": "One of each brand" },
    { "type": "text", "id": "fill_surprise_label", "label": "Quick fill: random", "default": "Surprise me" },
