{%- comment -%}
  Testimonials (anchor #reviews, where the product page's rating links to).
  Real reviews only, from two sources:
  - "Review" blocks you fill in from genuine customer reviews (quote, name, city,
    stars, verified buyer, which perfume);
  - app blocks: a reviews app's widget (Judge.me, Shopify Product Reviews…).
  With neither, the section shows nothing to shoppers (a hint in the editor only).
  On a product page the summary reads the reviews.rating / rating_count metafields
  the reviews app fills.

  The cards sit in a row that swipes and drags like the product rail
  (<perfume-rail> in assets/perfume-card.js). Styles: assets/perfume-reviews.css.
{%- endcomment -%}
{%- liquid
  assign tid = 'PerfumeReviews-' | append: section.id
  assign reviews = section.blocks | where: 'type', 'review'
  assign has_app = false
  for b in section.blocks
    if b.type == '@app'
      assign has_app = true
    endif
  endfor
  assign rating = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value | default: product.metafields.reviews.rating_count
-%}

{%- if reviews.size > 0 or has_app or request.design_mode -%}
  {{ 'perfume-card.css' | asset_url | stylesheet_tag }}
  {{ 'perfume-reviews.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'perfume-card.js' | asset_url }}" defer="defer"></script>

  {%- style -%}
    #{{ tid }} {
      --prv-bg: {{ section.settings.background_color }};
      --prv-ink: {{ section.settings.text_color }};
      --prv-pt: {{ section.settings.padding_top }}px;
      --prv-pb: {{ section.settings.padding_bottom }}px;
    }
  {%- endstyle -%}

  <section id="{{ tid }}" class="prv" aria-labelledby="{{ tid }}-heading">
    <span class="prv__anchor" id="reviews"></span>
    <div class="prv__head">
      <div>
        {%- if section.settings.kicker != blank -%}<p class="prv__kicker">{{ section.settings.kicker | escape }}</p>{%- endif -%}
        <h2 class="prv__heading" id="{{ tid }}-heading">{{ section.settings.heading | escape }}</h2>
      </div>
      {%- if rating != blank -%}
        {%- liquid
          assign r_value = rating.rating | times: 1.0
          assign r_max = rating.scale_max | default: 5
          assign r_pct = r_value | divided_by: r_max | times: 100
        -%}
        <p class="prv__summary">
          <span class="prv__score">{{ r_value | round: 1 }}</span>
          <span>
            <span class="prv__stars" style="--pct: {{ r_pct }}%;" aria-hidden="true">★★★★★</span>
            <span class="prv__count">{{ rating_count }} {% if rating_count == 1 %}review{% else %}reviews{% endif %}</span>
          </span>
          <span class="pf-visually-hidden">Rated {{ r_value | round: 1 }} out of {{ r_max }}</span>
        </p>
      {%- endif -%}
    </div>

    {%- if reviews.size > 0 -%}
      <perfume-rail>
        <ul class="prail__list prv__list" role="list" data-prail-list>
          {%- for block in reviews -%}
            {%- assign stars = block.settings.stars -%}
            <li class="prail__item" {{ block.shopify_attributes }}>
              <figure class="prv-card">
                {%- if stars > 0 -%}
                  <p class="prv-card__stars" aria-label="{{ stars }} out of 5 stars">
                    {%- for i in (1..5) -%}<span{% if i > stars %} class="is-off"{% endif %} aria-hidden="true">★</span>{%- endfor -%}
                  </p>
                {%- endif -%}
                {%- if block.settings.title != blank -%}<p class="prv-card__title">{{ block.settings.title | escape }}</p>{%- endif -%}
                <blockquote class="prv-card__quote">{{ block.settings.quote | escape }}</blockquote>
                <figcaption class="prv-card__who">
                  <span class="prv-card__name">{{ block.settings.name | escape }}{% if block.settings.city != blank %}, {{ block.settings.city | escape }}{% endif %}</span>
                  {%- if block.settings.verified -%}<span class="prv-card__verified">✓ Verified buyer</span>{%- endif -%}
                  {%- if block.settings.product_name != blank -%}<span class="prv-card__product">on {{ block.settings.product_name | escape }}</span>{%- endif -%}
                </figcaption>
              </figure>
            </li>
          {%- endfor -%}
        </ul>
        <div class="prail__controls" data-prail-controls hidden>
          <span class="prail__progress" aria-hidden="true"><span></span></span>
          <div class="prail__arrows">
            <button type="button" class="prail__arrow" data-prail-prev aria-label="Previous reviews">
              <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M12 4l-6 6 6 6"/></svg>
            </button>
            <button type="button" class="prail__arrow" data-prail-next aria-label="Next reviews">
              <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M8 4l6 6-6 6"/></svg>
            </button>
          </div>
        </div>
      </perfume-rail>
    {%- endif -%}

    {%- for block in section.blocks -%}
      {%- if block.type == '@app' -%}
        <div class="prv__app">{% render block %}</div>
      {%- endif -%}
    {%- endfor -%}

    {%- if reviews.size == 0 and has_app == false and request.design_mode -%}
      <p class="prv__hint">Add Review blocks from real customer reviews, or a reviews app block. Shoppers don't see this section until you do.</p>
    {%- endif -%}
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Testimonials",
  "tag": "div",
  "class": "section-perfume-reviews",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "paragraph", "content": "Real reviews only. Never write or edit reviews yourself; copy them as customers wrote them." },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Reviews" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What people say" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#EAD8C2" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#26221F" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range", "id": "stars", "label": "Stars", "min": 0, "max": 5, "step": 1, "default": 5, "info": "0 hides the stars." },
        { "type": "text", "id": "title", "label": "Title (optional)" },
        { "type": "textarea", "id": "quote", "label": "Review", "info": "As the customer wrote it." },
        { "type": "text", "id": "name", "label": "Name", "info": "Ask before showing a full name; first name and initial is common." },
        { "type": "text", "id": "city", "label": "City" },
        { "type": "text", "id": "product_name", "label": "Perfume reviewed" },
        { "type": "checkbox", "id": "verified", "label": "Verified buyer", "default": false }
      ]
    }
  ],
  "presets": [{ "name": "Testimonials" }]
}
{% endschema %}
