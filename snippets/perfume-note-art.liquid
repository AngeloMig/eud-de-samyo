      when 'mint'
        assign photo_url = 'https://images.unsplash.com/photo-1618130070080-91f4d55a2383?w=240&h=240&fit=crop&q=70&auto=format'
      when 'orange'
        assign photo_url = 'https://images.unsplash.com/photo-1582979512210-99b6a53386f9?w=240&h=240&fit=crop&q=70&auto=format'
      when 'grapefruit'
        assign photo_url = 'https://images.unsplash.com/photo-1787551742228-8af769f282d3?w=240&h=240&fit=crop&q=70&auto=format'
      when 'apple'
        assign photo_url = 'https://images.unsplash.com/photo-1678942946279-c83e37f32304?w=240&h=240&fit=crop&q=70&auto=format'
      when 'musk'
        assign photo_url = 'https://images.unsplash.com/photo-1705147293352-3e81c1b8ab5b?w=240&h=240&fit=crop&q=70&auto=format'
      when 'amber'
        assign photo_url = 'https://images.unsplash.com/photo-1631624406592-f599694e6b2c?w=240&h=240&fit=crop&q=70&auto=format'
      when 'mineral'
        assign photo_url = 'https://images.unsplash.com/photo-1614759258004-39da973d3268?w=240&h=240&fit=crop&q=70&auto=format'
      when 'tobacco'
        assign photo_url = 'https://images.unsplash.com/photo-1618843916388-29bb8a13b4fd?w=240&h=240&fit=crop&q=70&auto=format'
    endcase
  endunless
-%}
{%- if photo_url != blank -%}
  <span class="pf-note-art pf-note-photo pf-note-photo--full" aria-hidden="true">
    <img src="{{ photo_url }}" alt="" loading="lazy" width="240" height="240">
  </span>
{%- elsif photo_file != blank -%}
  <span class="pf-note-art pf-note-photo" style="--tint: {{ photo_tint }};" aria-hidden="true">
    <img src="{{ photo_file | asset_url }}" alt="" loading="lazy" width="160" height="160">
  </span>
{%- else -%}
