{%- comment -%}
  Placeholder bottle, shown until a real bottle photo is uploaded. An original,
  unbranded drawing: it only carries the perfume's name on a plain label.

  Usage: {% render 'perfume-bottle-art', shape: 'square', liquid: '#7f95ad', label: 'Sauvage', uid: block.id %}
  Shapes: square, column, round, faceted.
{%- endcomment -%}
{%- liquid
  assign gid = 'pf-glass-' | append: uid
  assign label_text = label | escape
  assign label_length = label | size
  assign fs = 16
  if label_length > 12
    assign fs = 10
  elsif label_length > 8
    assign fs = 12
  endif
-%}
<svg class="pf-bottle-art" viewBox="0 0 220 340" role="img" aria-label="{{ label_text }}">
  <defs>
    <linearGradient id="{{ gid }}" x1="0" x2="1" y1="0" y2="0">
      <stop offset="0" stop-color="{{ liquid }}" stop-opacity=".95"/>
      <stop offset=".5" stop-color="{{ liquid }}" stop-opacity=".62"/>
      <stop offset="1" stop-color="{{ liquid }}" stop-opacity=".95"/>
    </linearGradient>
  </defs>
  {%- case shape -%}
    {%- when 'column' -%}
      <rect x="86" y="6" width="48" height="92" rx="3" fill="#2A2622"/>
      <rect x="93" y="12" width="5" height="80" fill="#fff" opacity=".22"/>
      <rect x="96" y="98" width="28" height="12" fill="#BDB5A8"/>
      <rect x="56" y="110" width="108" height="222" rx="6" fill="url(#{{ gid }})" stroke="rgba(0,0,0,.12)"/>
      <rect x="64" y="118" width="92" height="206" rx="3" fill="none" stroke="#fff" stroke-opacity=".35"/>
      <rect x="70" y="128" width="8" height="180" rx="4" fill="#fff" opacity=".32"/>
      <rect x="74" y="206" width="72" height="40" fill="#fff" opacity=".78"/>
      <text x="110" y="231" text-anchor="middle" font-family="Cormorant Garamond, Georgia, serif" font-size="{{ fs }}" fill="#26221F">{{ label_text }}</text>
    {%- when 'round' -%}
      <circle cx="110" cy="46" r="34" fill="#C9B27A"/>
      <circle cx="98" cy="36" r="9" fill="#fff" opacity=".35"/>
      <rect x="94" y="78" width="32" height="26" fill="#B7A06A"/>
      <circle cx="110" cy="220" r="108" fill="url(#{{ gid }})" stroke="rgba(0,0,0,.12)"/>
      <circle cx="110" cy="220" r="96" fill="none" stroke="#fff" stroke-opacity=".35"/>
      <path d="M40 190c6-30 26-54 52-64" stroke="#fff" stroke-opacity=".4" stroke-width="9" stroke-linecap="round" fill="none"/>
      <rect x="66" y="208" width="88" height="40" rx="2" fill="#fff" opacity=".78"/>
      <text x="110" y="233" text-anchor="middle" font-family="Cormorant Garamond, Georgia, serif" font-size="{{ fs }}" fill="#26221F">{{ label_text }}</text>
    {%- when 'faceted' -%}
      <rect x="78" y="10" width="64" height="72" rx="2" fill="#141414"/>
      <rect x="86" y="16" width="6" height="60" fill="#fff" opacity=".22"/>
      <rect x="92" y="82" width="36" height="14" fill="#C8A85C"/>
      <path d="M44 96h132l18 234H26z" fill="url(#{{ gid }})" stroke="rgba(0,0,0,.12)"/>
      <path d="M58 106h104l14 214H44z" fill="none" stroke="#fff" stroke-opacity=".35"/>
      <path d="M62 112l-12 200" stroke="#fff" stroke-opacity=".4" stroke-width="8" stroke-linecap="round"/>
      <rect x="70" y="200" width="80" height="40" fill="#fff" opacity=".78"/>
      <text x="110" y="225" text-anchor="middle" font-family="Cormorant Garamond, Georgia, serif" font-size="{{ fs }}" fill="#26221F">{{ label_text }}</text>
    {%- else -%}
      <rect x="80" y="8" width="60" height="64" rx="4" fill="#1D1D1F"/>
      <rect x="88" y="14" width="6" height="52" fill="#fff" opacity=".25"/>
      <rect x="92" y="72" width="36" height="18" fill="#B9B2A6"/>
      <rect x="26" y="90" width="168" height="240" rx="14" fill="url(#{{ gid }})" stroke="rgba(0,0,0,.12)"/>
      <rect x="34" y="98" width="152" height="224" rx="8" fill="none" stroke="#fff" stroke-opacity=".35"/>
      <rect x="44" y="108" width="10" height="196" rx="5" fill="#fff" opacity=".35"/>
      <rect x="66" y="196" width="88" height="44" fill="#fff" opacity=".78"/>
      <text x="110" y="223" text-anchor="middle" font-family="Cormorant Garamond, Georgia, serif" font-size="{{ fs }}" fill="#26221F">{{ label_text }}</text>
  {%- endcase -%}
</svg>
